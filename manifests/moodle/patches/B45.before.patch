+        global $CFG;
+
+        if (during_initial_install()) {
+            return null;
+        }
+        $result = array();
+        foreach($this->types as $archetype) {
+            if ($caproles = get_archetype_roles($archetype)) {
+                foreach ($caproles as $caprole) {

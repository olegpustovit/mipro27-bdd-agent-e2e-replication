+
+    /**
+     * Getter for "indent"
+     * @return boolean
+     */
+    public function get_indent() {
+        return $this->indent;
+    }
+
+    /**
+     * Setter for "indent"
+     * @param $val boolean
+     */
+    public function set_indent($val) {
+        $this->indent = $val;
+    }
+
+    /**
+     * Getter for "smscreenonly"
+     * @return boolean
+     */
+    public function get_smscreenonly() {
+        return $this->smscreenonly;
+    }
+
+    /**
+     * Setter for "smscreenonly"

+  // src: url('@{fa-font-path}/FontAwesome.otf') format('opentype'); // used when developing fonts
+  font-weight: normal;
+  font-style: normal;
+}
diff --git a/lib/fonts/font-awesome-4.7.0/less/rotated-flipped.less b/lib/fonts/font-awesome-4.7.0/less/rotated-flipped.less

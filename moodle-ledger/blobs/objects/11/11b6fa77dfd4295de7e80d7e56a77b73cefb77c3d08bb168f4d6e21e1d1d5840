ifier);\\n270:     }\\n271: \\n272:     /**\\n273:      * Sets the specified value to the field.\\n274:      *\\n275:      * @Given /^I set the field \\\"(?P<field_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" to multiline:$/\\n276:      * @throws ElementNotFoundException Thrown by behat_base::find\\n277:      * @param string $field\\n278:      * @param PyStringNode $value\\n279:      * @return void\\n280:      */\\n281:     public function i_set_the_field_to_multiline($field, PyStringNode $value) {\\n282:         $this->set_field_value($field, (string)$value);\\n283:     }\\n284: \\n285:     /**\\n286:      * Sets the specified value to the field with xpath.\\n287:      *\\n288:      * @Given /^I set the field with xpath \\\"(?P<fieldxpath_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" to \\\"(?P<field_value_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\"$/\\n289:      * @throws ElementNotFoundException Thrown by behat_base::find\\n290:      * @param string $field\\n291:      * @param string $value\\n292:      * @return void\\n293:      */\\n294:     public function i_set_the_field_with_xpath_to($fieldxpath, $value) {\\n295:         $this->set_field_node_value($this->find('xpath', $fieldxpath), $value);\\n296:     }\\n297: \\n298:     /**\\n299:      * Checks, the field matches the value.\\n300:      *\"}"}],"provider":"mcp-json","providerName":"MCP Config"},"isError":false,"timestamp":1794800980394}}

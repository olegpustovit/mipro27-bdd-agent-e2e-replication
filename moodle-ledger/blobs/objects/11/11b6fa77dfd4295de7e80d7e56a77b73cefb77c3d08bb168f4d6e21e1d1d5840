 needs\\n46:  * when necessary and including only the ones we need to avoid\\n47:  * overlapping and confusion.\\n48:  *\\n49:  * @package   core\\n50:  * @category  test\\n51:  * @copyright 2012 David Monllaó\\n52:  * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later\\n53:  */\\n54: class behat_general extends behat_base {\\n55:     /**\\n56:      * @var string used by {@link switch_to_window()} and\\n57:      * {@link switch_to_the_main_window()} to work-around a Chrome browser issue.\\n58:      */\\n59:     public const MAIN_WINDOW_NAME = '__moodle_behat_main_window_name';\\n60: \\n61:     /**\\n62:      * @var string when we want to check whether or not a new page has loaded,\\n63:      * we first write this unique string into the page. Then later, by checking\\n64:      * whether it is still there, we can tell if a new page has been loaded.\\n65:      */\\n66:     public const PAGE_LOAD_DETECTION_STRING = 'new_page_not_loaded_since_behat_started_watching';\\n67: \\n68:     /**\\n69:      * @var $pageloaddetectionrunning boolean Used to ensure that page load detection was started before a page reload\\n70:      * was checked for.\\n71:      */\\n72:     private bool $pageloaddetectionrunning = false;\\n73: \\n74:     /**\\n75:      * Opens Moodle homepage.\\n76:      *\\n77:      * @Given /^I am on homepage$/\\n78:      */\\n79:     public function i_am_on_homepage() {\\n80:         $this->execute([self::class, 'i_visit'], ['/']);\\n81:     }\\n82: \\n83:     /**\\n84:      * Opens Moodle site homepage.\\n85:      *\\n86:      * @Given /^I am on site homepage$/\\n87:      */\\n88:     public function i_am_on_site_homepage() {\\n89:         $this->execute([self::class, 'i_visit'], ['/?redirect=0']);\\n90:     }\\n91: \\n92:     /**\\n93:      * Opens course index page.\\n94:      *\\n95:      * @Given /^I am on course index$/\\n96:      */\\n97:     public function i_am_on_course_index() {\\n98:         $this->execute([self::class, 'i_visit'], ['/course/index.php']);\\n99:     }\\n100: \\n101:     /**\\n102:      * Checks, that current page PATH matches regular expression\\n103:      *\\n104:      * Example: Then the url should match \\\"/course/index\\\\.php\\\"\\n105:      * Example: Then the url should match \\\"/mod/forum/view\\\\.php\\\\?id=[0-9]+\\\"\\n106:      * Example: And the url should match \\\"^http://moodle\\\\.org\\\"\\n107:      *\\n108:      * @Then /^the url should match (?P<pattern>\\\"(?:[^\\\"]|\\\\\\\\\\\")*\\\")$/\\n109:      * @param string $pattern The pattern that must match to the current url.\\n110:      */\\n111:     public function the_url_should_match($pattern) {\\n112:         $url = $this->getSession()->getCurrentUrl();\\n113: \\n114:         if (preg_match($pattern, $url) === 1) {\\n115:             return;\\n116:         }\\n117: \\n118:         throw new ExpectationException(sprintf('The url \\\"%s\\\" should match with %s', $url, $pattern), $this->getSession());\\n119:     }\\n120: \\n121:     /**\\n122:      * Reloads the current page.\\n123:      *\\n124:      * @Given /^I reload the page$/\\n125:      */\\n126:     public function reload() {\\n127:         $this->getSession()->reload();\\n128:     }\\n129: \\n130:     /**\\n131:      * Follows the page redirection. Use this step after any action that shows a message and waits for a redirection\\n132:      *\\n133:      * @Given /^I wait to be redirected$/\\n134:      */\\n135:     public function i_wait_to_be_redirected() {\\n136: \\n137:         // Xpath and processes based on core_renderer::redirect_message(), core_renderer::$metarefreshtag and\\n138:         // moodle_page::$periodicrefreshdelay possible values.\\n139:         if (!$metarefresh = $this->getSession()->getPage()->find('xpath', \\\"//head/descendant::meta[@http-equiv='refresh']\\\")) {\\n140:             // We don't fail the scenario if no redirection with message is found to avoid race condition false failures.\\n141:             return true;\\n142:         }\\n143: \\n144:         // Wrapped in try & catch in case the redirection has already been executed.\\n145:         try {\\n146:             $content = $metarefresh->getAttribute('content');\\n147:         } catch (NoSuchElementException $e) {\\n148:             return true;\\n149:         } catch (StaleElementReferenceException $e) {\\n150:             return true;\\n151:         }\\n152: \\n153:         // Getting the refresh time and the url if present.\\n154:         if (strstr($content, 'url') != false) {\\n155:             [$waittime, $url] = explode(';', $content);\\n156: \\n157:             // Cleaning the URL value.\\n158:             $url = trim(substr($url, strpos($url, 'http')));\\n159:         } else {\\n160:             // Just wait then.\\n161:             $waittime = $content;\\n162:         }\\n163: \\n164:         // Wait until the URL change is executed.\\n165:         if ($this->running_javascript()) {\\n166:             $this->getSession()->wait($waittime * 1000);\\n167:         } else if (!empty($url)) {\\n168:             // We redirect directly as we can not wait for an automatic redirection.\\n169:             $this->getSession()->getDriver()->getClient()->request('GET', $url);\\n170:         } else {\\n171:             // Reload the page if no URL was provided.\\n172:             $this->getSession()->getDriver()->reload();\\n173:         }\\n174:     }\\n175: \\n176:     /**\\n177:      * Switches to the specified iframe.\\n178:      *\\n179:      * @Given /^I switch to \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" iframe$/\\n180:      * @Given /^I switch to \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" class iframe$/\\n181:      * @param string $name The name of the iframe\\n182:      */\\n183:     public function switch_to_iframe($name) {\\n184:         // We spin to give time to the iframe to be loaded.\\n185:         // Using extended timeout as we don't know about which\\n186:         // kind of iframe will be loaded.\\n187:         $this->spin(\\n188:             function ($context) use ($name) {\\n189:                 $iframe = $context->find('iframe', $name);\\n190:                 if ($iframe->hasAttribute('name')) {\\n191:                     $iframename = $iframe->getAttribute('name');\\n192:                 } else {\\n193:                     if (!$this->running_javascript()) {\\n194:                         throw new \\\\coding_exception('iframe must have a name attribute to use the switchTo command.');\\n195:                     }\\n196:                     $iframename = uniqid();\\n197:                     $this->execute_js_on_node($iframe, \\\"{{ELEMENT}}.name = '{$iframename}';\\\");\\n198:                 }\\n199:                 $context->getSession()->switchToIFrame($iframename);\\n200:                 // Wait until the iframe is completely loaded and all pending operations complete.\\n201:                 $context->getSession()->wait(behat_base::get_extended_timeout(), behat_base::PAGE_READY_JS);\\n202: \\n203:                 // If no exception we are done.\\n204:                 return true;\\n205:             },\\n206:             behat_base::get_extended_timeout()\\n207:         );\\n208:     }\\n209: \\n210:     /**\\n211:      * Wait until the specified iframe is interactable (visible, sized, and not occluded).\\n212:      *\\n213:      * @Given /^I wait until \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" iframe is interactable$/\\n214:      * @Given /^I wait until \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" class iframe is interactable$/\\n215:      * @param string $name The name or class of the iframe\\n216:      */\\n217:     public function wait_until_iframe_interactable(string $name): void {\\n218:         if (!$this->running_javascript()) {\\n219:             throw new DriverException(\\n220:                 'iFrame interactability checks are disabled in scenarios without Javascript support',\\n221:             );\\n222:         }\\n223:         $this->spin(\\n224:             function ($context) use ($name) {\\n225:                 $iframe = $context->find('iframe', $name);\\n226:                 $scrolljs = '{{ELEMENT}}.scrollIntoView({behavior: \\\"auto\\\", block: \\\"center\\\", inline: \\\"center\\\"});';\\n227:                 $this->execute_js_on_node($iframe, $scrolljs);\\n228:                 $this->ensure_node_is_visible($iframe);\\n229: \\n230:                 // Check that the iframe is not occluded at its center point.\\n231:                 $iframexpath = $iframe->getXpath();\\n232:                 $js = <<<EOF\\n233:                     (function() {\\n234:                         const xpath = \\\"{$iframexpath}\\\";\\n235:                         const el = document.evaluate(\\n236:                             xpath,\\n237:                             document,\\n238:                             null,\\n239:                             XPathResult.FIRST_ORDERED_NODE_TYPE,\\n240:                             null\\n241:                         ).singleNodeValue;\\n242:                         if (!el) { return false; }\\n243:                         const rect = el.getBoundingClientRect();\\n244:                         if (rect.width === 0 || rect.height === 0) { return false; }\\n245:                         const x = rect.left + rect.width / 2;\\n246:                         const y = rect.top + rect.height / 2;\\n247:                         const target = document.elementFromPoint(x, y);\\n248:                         return target === el || el.contains(target);\\n249:                     })()\\n250:                 EOF;\\n251: \\n252:                 return (bool) $this->evaluate_script($js);\\n253:             },\\n254:             behat_base::get_extended_timeout()\\n255:         );\\n256:     }\\n257: \\n258:     /**\\n259:      * Wait until the specified iframe is interactable (visible, sized, and not occluded) and switche to it.\\n260:      *\
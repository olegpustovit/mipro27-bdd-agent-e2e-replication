ic function wait_until_iframe_interactable(string $name): void {\\n218:         if (!$this->running_javascript()) {\\n219:             throw new DriverException(\\n220:                 'iFrame interactability checks are disabled in scenarios without Javascript support',\\n221:             );\\n222:         }\\n223:         $this->spin(\\n224:             function ($context) use ($name) {\\n225:                 $iframe = $context->find('iframe', $name);\\n226:                 $scrolljs = '{{ELEMENT}}.scrollIntoView({behavior: \\\"auto\\\", block: \\\"center\\\", inline: \\\"center\\\"});';\\n227:                 $this->execute_js_on_node($iframe, $scrolljs);\\n228:                 $this->ensure_node_is_visible($iframe);\\n229: \\n230:                 // Check that the iframe is not occluded at its center point.\\n231:                 $iframexpath = $iframe->getXpath();\\n232:                 $js = <<<EOF\\n233:                     (function() {\\n234:                         const xpath = \\\"{$iframexpath}\\\";\\n235:                         const el = document.evaluate(\\n236:                             xpath,\\n237:                             document,\\n238:                             null,\\n239:                             XPathResult.FIRST_ORDERED_NODE_TYPE,\\n240:                             null\\n241:                         ).singleNodeValue;\\n242:                         if (!el) { return false; }\\n243:                         const rect = el.getBoundingClientRect();\\n244:                         if (rect.width === 0 || rect.height === 0) { return false; }\\n245:                         const x = rect.left + rect.width / 2;\\n246:                         const y = rect.top + rect.height / 2;\\n247:                         const target = document.elementFromPoint(x, y);\\n248:                         return target === el || el.contains(target);\\n249:                     })()\\n250:                 EOF;\\n251: \\n252:                 return (bool) $t
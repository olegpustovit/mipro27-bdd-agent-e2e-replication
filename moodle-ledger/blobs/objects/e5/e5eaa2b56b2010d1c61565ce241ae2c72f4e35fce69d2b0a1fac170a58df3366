hat it will be useful,\\n10: // but WITHOUT ANY WARRANTY; without even the implied warranty of\\n11: // MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\\n12: // GNU General Public License for more details.\\n13: //\\n14: // You should have received a copy of the GNU General Public License\\n15: // along with Moodle.  If not, see <http://www.gnu.org/licenses/>.\\n16: \\n17: /**\\n18:  * Steps definitions related with blocks.\\n19:  *\\n20:  * @package   core_block\\n21:  * @category  test\\n22:  * @copyright 2012 David Monllaó\\n23:  * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later\\n24:  */\\n25: \\n26: // NOTE: no MOODLE_INTERNAL test here, this file may be required by behat before including /config.php.\\n27: \\n28: use Behat\\\\Mink\\\\Exception\\\\ElementNotFoundException as ElementNotFoundException;\\n29: use Behat\\\\Gherkin\\\\Node\\\\TableNode as TableNode;\\n30: \\n31: require_once(__DIR__ . '/../../../lib/behat/behat_base.php');\\n32: \\n33: /**\\n34:  * Blocks management steps definitions.\\n35:  *\\n36:  * @package    core_block\\n37:  * @category   test\\n38:  * @copyright  2012 David Monllaó\\n39:  * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later\\n40:  */\\n41: class behat_blocks extends behat_base {\\n42: \\n43:     /**\\n44:      * Adds the selected block. Editing mode must be previously enabled.\\n45:      *\\n46:      * @Given /^I add the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block$/\\n47:      * @param string $blockname\\n48:      */\\n49:     public function i_add_the_block($blockname) {\\n50:         $addblock = get_string('addblock');\\n51:         $this->execute('behat_general::i_click_on_in_the', [$addblock, 'link_exact', '.add_block_button', 'css_element']);\\n52: \\n53:         if (!$this->running_javascript()) {\\n54:             $this->execute('behat_general::i_click_on_in_the', [$blockname, 'link_exact', '#region-main', 'css_element']);\\n55:         } else {\\n56:             $this->execute('behat_general::i_click_on_in_the', [$blockname, 'link_exact', $addblock, 'dialogue']);\\n57:         }\\n58:     }\\n59: \\n60:     /**\\n61:      * Adds the selected block to the specified region\\n62:      *\\n63:      * Editing mode must be previously enabled.\\n64:      *\\n65:      * @Given /^I add the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block to the \\\"(?P<region_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" region$/\\n66:      * @param string $blockname\\n67:      * @param string $region\\n68:      */\\n69:     public function i_add_the_block_to_the_region(string $blockname, string $region) {\\n70:         if (!$this->running_javascript()) {\\n71:             throw new coding_exception('Adding block to specific region is not possible with Javascript disabled');\\n72:         }\\n73:         if ($region === \\\"default\\\") {\\n74:             $region = \\\"\\\";\\n75:         }\\n76:         $csselement = 'a[data-key=\\\"addblock\\\"][data-blockregion='.behat_context_helper::escape($region).']';\\n77:         $addblock = get_string('addblock');\\n78:         $this->execute('behat_general::i_click_on', [$csselement, 'css_element']);\\n79:         $this->execute('behat_general::i_click_on_in_the', [$blockname, 'link_exact', $addblock, 'dialogue']);\\n80:     }\\n81: \\n82:     /**\\n83:      * Adds the selected block to the specified region and fills configuration form.\\n84:      *\\n85:      * Editing mode must be previously enabled.\\n86:      *\\n87:      * @Given /^I add the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block to the (?P<region_string>(?:[^\\\"]|\\\\\\\\\\\")*) region with:$/\\n88:      * @param string $blockname\\n89:      * @param string $region\\n90:      * @param TableNode $data\\n91:      */\\n92:     public function i_add_the_block_to_the_region_with(string $blockname, string $region, TableNode $data) {\\n93:         $blocklabel = get_string('textellipsis', 'moodle', $blockname);\\n94:         $this->execute('behat_blocks::i_add_the_block_to_the_region', [$blocklabel, $region]);\\n95:         $this->wait_for_pending_js();\\n96:         $dialogname = get_string('addblock', 'core_block', $blockname);\\n97:         $this->execute('behat_forms::i_set_the_following_fields_in_container_to_these_values',\\n98:             [$dialogname, \\\"dialogue\\\", $data]);\\n99:         $this->execute('behat_general::i_click_on_in_the', [\\\"Save changes\\\", 'button', $dialogname, 'dialogue']);\\n100:     }\\n101: \\n102:     /**\\n103:      * Adds the selected block if it is not already present. Editing mode must be previously enabled.\\n104:      *\\n105:      * @Given /^I add the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block if not present$/\\n106:      * @param string $blockname\\n107:      */\\n108:     public function i_add_the_block_if_not_present($blockname) {\\n109:         try {\\n110:             $this->get_text_selector_node('block', $blockname);\\n111:         } catch (ElementNotFoundException $e) {\\n112:             $this->execute('behat_blocks::i_add_the_block', [$blockname]);\\n113:         }\\n114:     }\\n115: \\n116:     /**\\n117:      * Opens a block's actions menu if it is not already opened.\\n118:      *\\n119:      * @Given /^I open the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" blocks action menu$/\\n120:      * @throws DriverException The step is not available when Javascript is disabled\\n121:      * @param string $blockname\\n122:      */\\n123:     public function i_open_the_blocks_action_menu($blockname) {\\n124: \\n125:         if (!$this->running_javascript()) {\\n126:             // Action menu does not need to be open if Javascript is off.\\n127:             return;\\n128:         }\\n129: \\n130:         // If it is already opened we do nothing.\\n131:         $blocknode = $this->get_text_selector_node('block', $blockname);\\n132:         if ($blocknode->hasClass('action-menu-shown')) {\\n133:             return;\\n134:         }\\n135: \\n136:         $this->execute('behat_general::i_click_on_in_the',\\n137:                 [\\\"a[data-bs-toggle='dropdown']\\\", \\\"css_element\\\", $this->escape($blockname), \\\"block\\\"]\\n138:         );\\n139:     }\\n140: \\n141:     /**\\n142:      * Clicks on Configure block for specified block. Page must be in editing mode.\\n143:      *\\n144:      * Argument block_name may be either the name of the block or CSS class of the block.\\n145:      *\\n146:      * @Given /^I configure the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block$/\\n147:      * @param string $blockname\\n148:      */\\n149:     public function i_configure_the_block($blockname) {\\n150:         // Note that since $blockname may be either block name or CSS class, we can not use the exact label of \\\"Configure\\\" link.\\n151: \\n152:         $this->execute(\\\"behat_blocks::i_open_the_blocks_action_menu\\\", $this->escape($blockname));\\n153: \\n154:         $this->execute('behat_general::i_click_on_in_the',\\n155:             array(\\\"Configure\\\", \\\"link\\\", $this->escape($blockname), \\\"block\\\")\\n156:         );\\n157:     }\\n158: \\n159:     /**\\n160:      * Ensures that block can be added to the page but does not actually add it.\\n161:      *\\n162:      * @Then /^the add block selector should contain \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block$/\\n163:      * @param string $blockname\\n164:      */\\n165:     public function the_add_block_selector_should_contain_block($blockname) {\\n166:         $addblock = get_string('addblock');\\n167:         $this->execute('behat_general::i_click_on', [$addblock, 'link_exact']);\\n168: \\n169: \\n170:         $cancelstr = get_string('cancel');\\n171:         if (!$this->running_javascript()) {\\n172:             $this->execute('behat_general::should_exist_in_the', [$blockname, 'link_exact', '#region-main', 'css_element']);\\n173:             $this->execute('behat_general::i_click_on_in_the', [$cancelstr, 'link_exact', '#region-main', 'css_element']);\\n174:         } else {\\n175:             $this->execute('behat_general::should_exist_in_the', [$blockname, 'link_exact', $addblock, 'dialogue']);\\n176:             $this->execute('behat_general::i_click_on_in_the', [$cancelstr, 'button', $addblock, 'dialogue']);\\n177:         }\\n178:     }\\n179: \\n180:     /**\\n181:      * Ensures that block can not be added to the page.\\n182:      *\\n183:      * @Then /^the add block selector should not contain \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block$/\\n184:      * @param string $blockname\\n185:      */\\n186:     public function the_add_block_selector_should_not_contain_block($blockname) {\\n187:         $addblock = get_string('addblock');\\n188:         $this->execute('behat_general::i_click_on', [$addblock, 'link_exact']);\\n189: \\n190: \\n191:         $cancelstr = get_string('cancel');\\n192:         if (!$this->running_javascript()) {\\n193:             $this->execute('behat_general::should_not_exist_in_the', [$blockname, 'link_exact', '#region-main', 'css_element']);\\n194:             $this->execute('behat_general::i_click_on_in_the', [$cancelstr, 'link_exact', '#region-main', 'css_element']);\\n195:         } else {\\n196:             $this->execute('behat_general::should_not_exist_in_the', [$blockname, 'link_exact', $addblock, 'dialogue']);\\n197:             $this->execute('behat_general::i_click_on_in_the', [$cancelstr, 'button', $addblock, 'dialogue']);\\n198:         }\\n199:     }\\n200: }\\n201: \"}"}],"details":{"serverName":"study","mcpToolName":"moodle_repair_read","rawContent":[{"type":"text","text":"{\"path\":\"public/blocks/tests/behat/behat_blocks.php\",\"totalLines\":201,\"text\":\"1: <?php\\n2: // This file is part of Moodle - http://moodle.org/\\n3: //\\n4: // Moodle is free software: you can redistribute it and/or modify\\n5: // it under the terms of the GNU General Public License as published by\\n6: // the Free Software Foundation, either version 3 of the License, or\\n7: // (at your option) any later version.\\n8: //\\n9: // Moodle is distributed in the hope that it will be useful,\\n10: // but WITHOUT ANY WARRANTY; without even the implied warranty of\\n11: // MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\\n12: // GNU General Public License for more details.\\n13: //\\n14: // You should have received a copy of the GNU General Public License\\n15: // along with Moodle.  If not, see <http://www.gnu.org/licenses/>.\\n16: \\n17: /**\\n18:  * Steps definitions related with blocks.\\n19:  *\\n20:  * @package   core_block\\n21:  * @category  test\\n22:  * @copyright 2012 David Monllaó\\n23:  * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later\\n24:  */\\n25: \\n26: // NOTE: no MOODLE_INTERNAL test here, this file may be required by behat before including /config.php.\\n27: \\n28: use Behat\\\\Mink\\\\Exception\\\\ElementNotFoundException as ElementNotFoundException;\\n29: use Behat\\\\Gherkin\\\\Node\\\\TableNode as TableNode;\\n30: \\n31: require_once(__DIR__ . '/../../../lib/behat/behat_base.php');\\n32: \\n33: /**\\n34:  * Blocks management steps definitions.\\n35:  *\\n36:  * @package    core_block\\n37:  * @category   test\\n38:  * @copyright  2012 David Monllaó\\n39:  * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later\\n40:  */\\n41: class behat_blocks extends behat_base {\\n42: \\n43:     /**\\n44:      * Adds the selected block. Editing mode must be previously enabled.\\n45:      *\\n46:      * @Given /^I add the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block$/\\n47:      * @param string $blockname\\n48:      */\\n49:     public function i_add_the_block($blockname) {\\n50:         $addblock = get_string('addblock');\\n51:         $this->execute('behat_general::i_click_on_in_the', [$addblock, 'link_exact', '.add_block_button', 'css_element']);\\n52: \\n53:         if (!$this->running_javascript()) {\\n54:             $this->execute('behat_general::i_click_on_in_the', [$blockname, 'link_exact', '#region-main', 'css_element']);\\n55:         } else {\\n56:             $this->execute('behat_general::i_click_on_in_the', [$blockname, 'link_exact', $addblock, 'dialogue']);\\n57:         }\\n58:     }\\n59: \\n60:     /**\\n61:      * Adds the selected block to the specified region\\n62:      *\\n63:      * Editing mode must be previously enabled.\\n64:      *\\n65:      * @Given /^I add the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block to the \\\"(?P<region_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" region$/\\n66:      * @param string $blockname\\n67:      * @param string $region\\n68:      */\\n69:     public function i_add_the_block_to_the_region(string $blockname, string $region) {\\n70:         if (!$this->running_javascript()) {\\n71:             throw new coding_exception('Adding block to specific region is not possible with Javascript disabled');\\n72:         }\\n73:         if ($region === \\\"default\\\") {\\n74:             $region = \\\"\\\";\\n75:         }\\n76:         $csselement = 'a[data-key=\\\"addblock\\\"][data-blockregion='.behat_context_helper::escape($region).']';\\n77:         $addblock = get_string('addblock');\\n78:         $this->execute('behat_general::i_click_on', [$csselement, 'css_element']);\\n79:         $this->execute('behat_general::i_click_on_in_the', [$blockname, 'link_exact', $addblock, 'dialogue']);\\n80:     }\\n81: \\n82:     /**\\n83:      * Adds the selected block to the specified region and fills configuration form.\\n84:      *\\n85:      * Editing mode must be previously enabled.\\n86:      *\\n87:      * @Given /^I add the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block to the (?P<region_string>(?:[^\\\"]|\\\\\\\\\\\")*) region with:$/\\n88:      * @param string $blockname\\n89:      * @param string $region\\n90:      * @param TableNode $data\\n91:      */\\n92:     public function i_add_the_block_to_the_region_with(string $blockname, string $region, TableNode $data) {\\n93:         $blocklabel = get_string('textellipsis', 'moodle', $blockname);\\n94:         $this->execute('behat_blocks::i_add_the_block_to_the_region', [$blocklabel, $region]);\\n95:         $this->wait_for_pending_js();\\n96:         $dialogname = get_string('addblock', 'core_block', $blockname);\\n97:         $this->execute('behat_forms::i_set_the_following_fields_in_container_to_these_values',\\n98:             [$dialogname, \\\"dialogue\\\", $data]);\\n99:         $this->execute('behat_general::i_click_on_in_the', [\\\"Save changes\\\", 'button', $dialogname, 'dialogue']);\\n100:     }\\n101: \\n102:     /**\\n103:      * Adds the selected block if it is not already present. Editing mode must be previously enabled.\\n104:      *\\n105:      * @Given /^I add the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block if not present$/\\n106:      * @param string $blockname\\n107:      */\\n108:     public function i_add_the_block_if_not_present($blockname) {\\n109:         try {\\n110:             $this->get_text_selector_node('block', $blockname);\\n111:         } catch (ElementNotFoundException $e) {\\n112:             $this->execute('behat_blocks::i_add_the_block', [$blockname]);\\n113:         }\\n114:     }\\n115: \\n116:     /**\\n117:      * Opens a block's actions menu if it is not already opened.\\n118:      *\\n119:      * @Given /^I open the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" blocks action menu$/\\n120:      * @throws DriverException The step is not available when Javascript is disabled\\n121:      * @param string $blockname\\n122:      */\\n123:     public function i_open_the_blocks_action_menu($blockname) {\\n124: \\n125:         if (!$this->running_javascript()) {\\n126:             // Action menu does not need to be open if Javascript is off.\\n127:             return;\\n128:         }\\n129: \\n130:         // If it is already opened we do nothing.\\n131:         $blocknode = $this->get_text_selector_node('block', $blockname);\\n132:         if ($blocknode->hasClass('action-menu-shown')) {\\n133:             return;\\n134:         }\\n135: \\n136:         $this->execute('behat_general::i_click_on_in_the',\\n137:                 [\\\"a[data-bs-toggle='dropdown']\\\", \\\"css_element\\\", $this->escape($blockname), \\\"block\\\"]\\n138:         );\\n139:     }\\n140: \\n141:     /**\\n142:      * Clicks on Configure block for specified block. Page must be in editing mode.\\n143:      *\\n144:      * Argument block_name may be either the name of the block or CSS class of the block.\\n145:      *\\n146:      * @Given /^I configure the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block$/\\n147:      * @param string $blockname\\n148:      */\\n149:     public function i_configure_the_block($blockname) {\\n150:         // Note that since $blockname may be either block name or CSS class, we can not use the exact label of \\\"Configure\\\" link.\\n151: \\n152:         $this->execute(\\\"behat_blocks::i_open_the_blocks_action_menu\\\", $this->escape($blockname));\\n153: \\n154:         $this->execute('behat_general::i_click_on_in_the',\\n155:             array(\\\"Configure\\\", \\\"link\\\", $this->escape($blockname), \\\"block\\\")\\n156:         );\\n157:     }\\n158: \\n159:     /**\\n160:      * Ensures that block can be added to the page but does not actually add it.\\n161:      *\\n162:      * @Then /^the add block selector should contain \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block$/\\n163:      * @param string $blockname\\n164:      */\\n165:     public function the_add_block_selector_should_contain_block($blockname) {\\n166:         $addblock = get_string('addblock');\\n167:         $this->execute('behat_general::i_click_on', [$addblock, 'link_exact']);\\n168: \\n169: \\n170:         $cancelstr = get_string('cancel');\\n171:         if (!$this->running_javascript()) {\\n172:             $this->execute('behat_general::should_exist_in_the', [$blockname, 'link_exact', '#region-main', 'css_element']);\\n173:             $this->execute('behat_general::i_click_on_in_the', [$cancelstr, 'link_exact', '#region-main', 'css_element']);\\n174:         } else {\\n175:             $this->execute('behat_general::should_exist_in_the', [$blockname, 'link_exact', $addblock, 'dialogue']);\\n176:             $this->execute('behat_general::i_click_on_in_the', [$cancelstr, 'button', $addblock, 'dialogue']);\\n177:         }\\n178:     }\\n179: \\n180:     /**\\n181:      * Ensures that block can not be added to the page.\\n182:      *\\n183:      * @Then /^the add block selector should not contain \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block$/\\n184:      * @param string $blockname\\n185:      */\\n186:     public function the_add_block_selector_should_not_contain_block($blockname) {\\n187:         $addblock = get_string('addblock');\\n188:         $this->execute('behat_general::i_click_on', [$addblock, 'link_exact']);\\n189: \\n190: \\n191:         $cancelstr = get_string('cancel');\\n192:         if (!$this->running_javascript()) {\\n193:             $this->execute('behat_general::should_not_exist_in_the', [$blockname, 'link_exact', '#region-main', 'css_element']);\\n194:             $this->execute('behat_general::i_click_on_in_the', [$cancelstr, 'link_exact', '#region-main', 'css_element']);\\n195:         } else {\\n196:             $this->execute('behat_general::should_not_exist_in_the', [$blockname, 'link_exact', $addblock, 'dialogue']);\\n197:             $this->execute('behat_general::i_click_on_in_the', [$cancelstr, 'button', $addblock, 'dialogue']);\\n198:         }\\n199:     }\\n200: }\\n201: \"}"}],"provider":"mcp-json","providerName":"MCP Config"},"isError":false,"timestamp":1794801692261},{"role":"toolResult","toolCallId":"toolu_01MNUEzY41v9oPDZfLpJn6gc","toolName":"mcp__study_moodle_repair_read","content":[{"type":"text","text":"{\"path\":\"public/lib/tests/behat/behat_general.php\",\"totalLines\":2899,\"text\":\"1: <?php\\n2: // This file is part of Moodle - http://moodle.org/\\n3: //\\n4: // Moodle is free software: you can redistribute it and/or modify\\n5: // it under the terms of the GNU General Public License as published by\\n6: // the Free Software Foundation, either version 3 of the License, or\\n7: // (at your option) any later version.\\n8: //\\n9: // Moodle is distributed in the hope that it will be useful,\\n10: // but WITHOUT ANY WARRANTY; without even the implied warranty of\\n11: // MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\\n12: // GNU General Public License for more details.\\n13: //\\n14: // You should have received a copy of the GNU General Public License\\n15: // along with Moodle.  If not, see <http://www.gnu.org/licenses/>.\\n16: \\n17: /**\\n18:  * General use steps definitions.\\n19:  *\\n20:  * @package   core\\n21:  * @category  test\\n22:  * @copyright 2012 David Monllaó\\n23:  * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later\\n24:  */\\n25: \\n26: // NOTE: no MOODLE_INTERNAL test here, this file may be required by behat before including /config.php.\\n27: \\n28: require_once(__DIR__ . '/../../behat/behat_base.php');\\n29: \\n30: use Behat\\\\Gherkin\\\\Node\\\\TableNode;\\n31: use Behat\\\\Mink\\\\Element\\\\NodeElement;\\n32: use Behat\\\\Mink\\\\Exception\\\\DriverException;\\n33: use Behat\\\\Mink\\\\Exception\\\\ElementNotFoundException;\\n34: use Behat\\\\Mink\\\\Exception\\\\ExpectationException;\\n35: use Facebook\\\\WebDriver\\\\Exception\\\\NoSuchAlertException;\\n36: use Facebook\\\\WebDriver\\\\Exception\\\\NoSuchElementException;\\n37: use Facebook\\\\WebDriver\\\\Exception\\\\StaleElementReferenceException;\\n38: use Facebook\\\\WebDriver\\\\WebDriverAlert;\\n39: use Facebook\\\\WebDriver\\\\WebDriverExpectedCondition;\\n40: \\n41: /**\\n42:  * Cross component steps definitions.\\n43:  *\\n44:  * Basic web application definitions from MinkExtension and\\n45:  * BehatchExtension. Definitions modified according to our needs\\n46:  * when necessary and including only the ones we need to avoid\\n47:  * overlapping and confusion.\\n48:  *\\n49:  * @package   core\\n50:  * @category  test\\n51:  * @copyright 2012 David Monllaó\\n52:  * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later\\n53:  */\\n54: class behat_general extends behat_base {\\n55:     /**\\n56:      * @var string used by {@link switch_to_window()} and\\n57:      * {@link switch_to_the_main_window()} to work-around a Chrome browser issue.\\n58:      */\\n59:     public const MAIN_WINDOW_NAME = '__moodle_behat_main_window_name';\\n60: \\n61:     /**\\n62:      * @var string when we want to check whether or not a new page has loaded,\\n63:      * we first write this unique string into the page. Then later, by checking\\n64:      * whether it is still there, we can tell if a new page has been loaded.\\n65:      */\\n66:     public const PAGE_LOAD_DETECTION_STRING = 'new_page_not_loaded_since_behat_started_watching';\\n67: \\n68:     /**\\n69:      * @var $pageloaddetectionrunning boolean Used to ensure that page load detection was started before a page reload\\n70:      * was checked for.\\n71:      */\\n72:     private bool $pageloaddetectionrunning = false;\\n73: \\n74:     /**\\n75:      * Opens Moodle homepage.\\n76:      *\\n77:      * @Given /^I am on homepage$/\\n78:      */\\n79:     public function i_am_on_homepage() {\\n80:         $this->execute([self::class, 'i_visit'], ['/']);\\n81:     }\\n82: \\n83:     /**\\n84:      * Opens Moodle site homepage.\\n85:      *\\n86:      * @Given /^I am on site homepage$/\\n87:      */\\n88:     public function i_am_on_site_homepage() {\\n89:         $this->execute([self::class, 'i_visit'], ['/?redirect=0']);\\n90:     }\\n91: \\n92:     /**\\n93:      * Opens course index page.\\n94:      *\\n95:      * @Given /^I am on course index$/\\n96:      */\\n97:     public function i_am_on_course_index() {\\n98:         $this->execute([self::class, 'i_visit'], ['/course/index.php']);\\n99:     }\\n100: \\n101:     /**\\n102:      * Checks, that current page PATH matches regular expression\\n103:      *\\n104:      * Example: Then the url should match \\\"/course/index\\\\.php\\\"\\n105:      * Example: Then the url should match \\\"/mod/forum/view\\\\.php\\\\?id=[0-9]+\\\"\\n106:      * Example: And the url should match \\\"^http://moodle\\\\.org\\\"\\n107:      *\\n108:      * @Then /^the url should match (?P<pattern>\\\"(?:[^\\\"]|\\\\\\\\\\\")*\\\")$/\\n109:      * @param string $pattern The pattern that must match to the current url.\\n110:      */\\n111:     public function the_url_should_match($pattern) {\\n112:         $url = $this->getSession()->getCurrentUrl();\\n113: \\n114:         if (preg_match($pattern, $url) === 1) {\\n115:             return;\\n116:         }\\n117: \\n118:         throw new ExpectationException(sprintf('The url \\\"%s\\\" should match with %s', $url, $pattern), $this->getSession());\\n119:     }\\n120: \\n121:     /**\\n122:      * Reloads the current page.\\n123:      *\\n124:      * @Given /^I reload the page$/\\n125:      */\\n126:     public function reload() {\\n127:         $this->getSession()->reload();\\n128:     }\\n129: \\n130:     /**\\n131:      * Follows the page redirection. Use this step after any action that shows a message and waits for a redirection\\n132:      *\\n133:      * @Given /^I wait to be redirected$/\\n134:      */\\n135:     public function i_wait_to_be_redirected() {\\n136: \\n137:         // Xpath and processes based on core_renderer::redirect_message(), core_renderer::$metarefreshtag and\\n138:         // moodle_page::$periodicrefreshdelay possible values.\\n139:         if (!$metarefresh = $this->getSession()->getPage()->find('xpath', \\\"//head/descendant::meta[@http-equiv='refresh']\\\")) {\\n140:             // We don't fail the scenario if no redirection with message is found to avoid race condition false failures.\\n141:             return true;\\n142:         }\\n143: \\n144:         // Wrapped in try & catch in case the redirection has already been executed.\\n145:         try {\\n146:             $content = $metarefresh->getAttribute('content');\\n147:         } catch (NoSuchElementException $e) {\\n148:             return true;\\n149:         } catch (StaleElementReferenceException $e) {\\n150:             return true;\\n151:         }\\n152: \\n153:         // Getting the refresh time and the url if present.\\n154:         if (strstr($content, 'url') != false) {\\n155:             [$waittime, $url] = explode(';', $content);\\n156: \\n157:             // Cleaning the URL value.\\n158:             $url = trim(substr($url, strpos($url, 'http')));\\n159:         } else {\\n160:             // Just wait then.\\n161:             $waittime = $content;\\n162:         }\\n163: \\n164:         // Wait until the URL change is executed.\\n165:         if ($this->running_javascript()) {\\n166:             $this->getSession()->wait($waittime * 1000);\\n167:         } else if (!empty($url)) {\\n168:             // We redirect directly as we can not wait for an automatic redirection.\\n169:             $this->getSession()->getDriver()->getClient()->request('GET', $url);\\n170:         } else {\\n171:             // Reload the page if no URL was provided.\\n172:             $this->getSession()->getDriver()->reload();\\n173:         }\\n174:     }\\n175: \\n176:     /**\\n177:      * Switches to the specified iframe.\\n178:      *\\n179:      * @Given /^I switch to \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" iframe$/\\n180:      * @Given /^I switch to \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" class iframe$/\\n181:      * @param string $name The name of the iframe\\n182:      */\\n183:     public function switch_to_iframe($name) {\\n184:         // We spin to give time to the iframe to be loaded.\\n185:         // Using extended timeout as we don't know about which\\n186:         // kind of iframe will be loaded.\\n187:         $this->spin(\\n188:             function ($context) use ($name) {\\n189:                 $iframe = $context->find('iframe', $name);\\n190:                 if ($iframe->hasAttribute('name')) {\\n191:                     $iframename = $iframe->getAttribute('name');\\n192:                 } else {\\n193:                     if (!$this->running_javascript()) {\\n194:                         throw new \\\\coding_exception('iframe must have a name attribute to use the switchTo command.');\\n195:                     }\\n196:                     $iframename = uniqid();\\n197:                     $this->execute_js_on_node($iframe, \\\"{{ELEMENT}}.name = '{$iframename}';\\\");\\n198:                 }\\n199:                 $context->getSession()->switchToIFrame($iframename);\\n200:                 // Wait until the iframe is completely loaded and all pending operations complete.\\n201:                 $context->getSession()->wait(behat_base::get_extended_timeout(), behat_base::PAGE_READY_JS);\\n202: \\n203:                 // If no exception we are done.\\n204:                 return true;\\n205:             },\\n206:             behat_base::get_extended_timeout()\\n207:         );\\n208:     }\\n209: \\n210:     /**\\n211:      * Wait until the specified iframe is interactable (visible, sized, and not occluded).\\n212:      *\\n213:      * @Given /^I wait until \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" iframe is interactable$/\\n214:      * @Given /^I wait until \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" class iframe is interactable$/\\n215:      * @param string $name The name or class of the iframe\\n216:      */\\n217:     public function wait_until_iframe_interactable(string $name): void {\\n218:         if (!$this->running_javascript()) {\\n219:    
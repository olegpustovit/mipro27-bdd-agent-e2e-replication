s behat_base {\\n42: \\n43:     /**\\n44:      * Adds the selected block. Editing mode must be previously enabled.\\n45:      *\\n46:      * @Given /^I add the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block$/\\n47:      * @param string $blockname\\n48:      */\\n49:     public function i_add_the_block($blockname) {\\n50:         $addblock = get_string('addblock');\\n51:         $this->execute(\\n52:             'behat_general::i_click_on_in_the',\\n53:             [$addblock, 'link_exact', '[data-region=\\\"add-block-button\\\"]', 'css_element']\\n54:         );\\n55: \\n56:         if (!$this->running_javascript()) {\\n57:             $this->execute('behat_general::i_click_on_in_the', [$blockname, 'link_exact', '#region-main', 'css_element']);\\n58:         } else {\\n59:             $this->execute('behat_general::i_click_on_in_the', [$blockname, 'link_exact', $addblock, 'dialogue']);\\n60:         }\\n61:     }\\n62: \\n63:     /**\\n64:      * Adds the selected block to the specified region\\n65:      *\\n66:      * Editing mode must be previously enabled.\\n67:      *\\n68:      * @Given /^I add the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block to the \\\"(?P<region_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" region$/\\n69:      * @param string $blockname\\n70:      * @param string $region\\n71:      */\\n72:     public function i_add_the_block_to_the_region(string $blockname, string $region) {\\n73:         if (!$this->running_javascript()) {\\n74:             throw new coding_exception('Adding block to specific region is not possible with Javascript disabled');\\n75:         }\\n76:         if ($region === \\\"default\\\") {\\n77:             $region = \\\"\\\";\\n78:         }\\n79:         $csselement = 'a[data-key=\\\"addblock\\\"][data-blockregion='.behat_context_helper::escape($region).']';\\n80:         $addblock = get_string('addblock');\\n81:         $this->execute('behat_general::i_click_on', [$csselement, 'css_element']);\\n82:         $this->execute('behat_general::i_click_on_in_the', [$blockname, 'link_exact', $addblock, 'dialogue']);\\n83:     }\\n84: \\n85:     /**\\n86:      * Adds the selected block to the specified region and fills configuration form.\\n87:      *\\n88:      * Editing mode must be previously enabled.\\n89:      *\\n90:      * @Given /^I add the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block to the (?P<region_string>(?:[^\\\"]|\\\\\\\\\\\")*) region with:$/\\n91:      * @param string $blockname\\n92:      * @param string $region\\n93:      * @param TableNode $data\\n94:      */\\n95:     public function i_add_the_block_to_the_region_with(string $blockname, string $region, TableNode $data) {\\n96:         $blocklabel = get_string('textellipsis', 'moodle', $blockname);\\n97:         $this->execute('behat_blocks::i_add_the_block_to_the_region', [$blocklabel, $region]);\\n98:         $this->wait_for_pending_js();\\n99:         $dialogname = get_string('addblock', 'core_block', $blockname);\\n100:         $this->execute('behat_forms::i_set_the_following_fields_in_container_to_these_values',\\n101:             [$dialogname, \\\"dialogue\\\", $data]);\\n102:         $this->execute('behat_general::i_click_on_in_the', [\\\"Save changes\\\", 'button', $dialogname, 'dialogue']);\\n103:     }\\n104: \\n105:     /**\\n106:      * Adds the selected block if it is not already present. Editing mode must be previously enabled.\\n107:      *\\n108:      * @Given /^I add the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block if not present$/\\n109:      * @param string $blockname\\n110:      */\\n111:     public function i_add_the_block_if_not_present($blockname) {\\n112:         try {\\n113:             $this->get_text_selector_node('block', $blockname);\\n114:         } catch (ElementNotFoundException $e) {\\n115:             $this->execute('behat_blocks::i_add_the_block', [$blockname]);\\n116:         }\\n117:     }\\n118: \\n119:     /**\\n120:      * Opens a block's actions menu if it is not already opened.\\n121:      *\\n122:      * @Given /^I open the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" blocks action menu$/\\n123:      * @throws DriverException The step is not available when Javascript is disabled\\n124:      * @param string $blockname\\n125:      */\\n126:     public function i_open_the_blocks_action_menu($blockname) {\\n127: \\n128:         if (!$this->running_javascript()) {\\n129:             // Action menu does not need to be open if Javascript is off.\\n130:             return;\\n131:         }\\n132: \\n133:         // If it is already opened we do nothing.\\n134:         $blocknode = $this->get_text_selector_node('block', $blockname);\\n135:         if ($blocknode->hasClass('action-menu-shown')) {\\n136:             return;\\n137:         }\\n138: \\n139:         $this->execute('behat_general::i_click_on_in_the',\\n140:                 [\\\"a[data-bs-toggle='dropdown']\\\", \\\"css_element\\\", $this->escape($blockname), \\\"block\\\"]\\n141:         );\\n142:     }\\n143: \\n144:     /**\\n145:      * Clicks on Configure block for specified block. Page must be in editing mode.\\n146:      *\\n147:      * Argument block_name may be either the name of the block or CSS class of the block.\\n148:      *\\n149:      * @Given /^I configure the \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block$/\\n150:      * @param string $blockname\\n151:      */\\n152:     public function i_configure_the_block($blockname) {\\n153:         // Note that since $blockname may be either block name or CSS class, we can not use the exact label of \\\"Configure\\\" link.\\n154: \\n155:         $this->execute(\\\"behat_blocks::i_open_the_blocks_action_menu\\\", $this->escape($blockname));\\n156: \\n157:         $this->execute('behat_general::i_click_on_in_the',\\n158:             array(\\\"Configure\\\", \\\"link\\\", $this->escape($blockname), \\\"block\\\")\\n159:         );\\n160:     }\\n161: \\n162:     /**\\n163:      * Ensures that block can be added to the page but does not actually add it.\\n164:      *\\n165:      * @Then /^the add block selector should contain \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block$/\\n166:      * @param string $blockname\\n167:      */\\n168:     public function the_add_block_selector_should_contain_block($blockname) {\\n169:         $addblock = get_string('addblock');\\n170:         $this->execute('behat_general::i_click_on', [$addblock, 'link_exact']);\\n171: \\n172: \\n173:         $cancelstr = get_string('cancel');\\n174:         if (!$this->running_javascript()) {\\n175:             $this->execute('behat_general::should_exist_in_the', [$blockname, 'link_exact', '#region-main', 'css_element']);\\n176:             $this->execute('behat_general::i_click_on_in_the', [$cancelstr, 'link_exact', '#region-main', 'css_element']);\\n177:         } else {\\n178:             $this->execute('behat_general::should_exist_in_the', [$blockname, 'link_exact', $addblock, 'dialogue']);\\n179:             $this->execute('behat_general::i_click_on_in_the', [$cancelstr, 'button', $addblock, 'dialogue']);\\n180:         }\\n181:     }\\n182: \\n183:     /**\\n184:      * Ensures that block can not be added to the page.\\n185:      *\\n186:      * @Then /^the add block selector should not contain \\\"(?P<block_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" block$/\\n187:      * @param string $blockname\\n188:      */\\n189:     public function the_add_block_selector_should_not_contain_block($blockname) {\\n190:         $addblock = get_string('addblock');\\n191:         $this->execute('behat_general::i_click_on', [$addblock, 'link_exact']);\\n192: \\n193: \\n194:         $cancelstr = get_string('cancel');\\n195:         if (!$this->running_javascript()) {\\n196:             $this->execute('behat_general::should_not_exist_in_the', [$blockname, 'link_exact', '#region-main', 'css_element']);\\n197:             $this->execute('behat_general::i_click_on_in_the', [$cancelstr, 'link_exact', '#region-main', 'css_element']);\\n198:         } else {\\n199:             $this->execute('behat_general::should_not_exist_in_the', [$blockname, 'link_exact', $addblock, 'dialogue']);\\n200:             $this->execute('behat_general::i_click_on_in_the', [$cancelstr, 'button', $addblock, 'dialogue']);\\n201:         }\\n202:     }\\n203: }\\n204: \"}"}],"structured_content":null},"error":null,"status":"completed"}}

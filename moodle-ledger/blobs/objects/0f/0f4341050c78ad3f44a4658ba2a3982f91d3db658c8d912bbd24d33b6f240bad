ption\\\\ElementNotFoundException;\\n34: use Behat\\\\Mink\\\\Exception\\\\ExpectationException;\\n35: use Facebook\\\\WebDriver\\\\Exception\\\\NoSuchAlertException;\\n36: use Facebook\\\\WebDriver\\\\Exception\\\\NoSuchElementException;\\n37: use Facebook\\\\WebDriver\\\\Exception\\\\StaleElementReferenceException;\\n38: use Facebook\\\\WebDriver\\\\WebDriverAlert;\\n39: use Facebook\\\\WebDriver\\\\WebDriverExpectedCondition;\\n40: \\n41: /**\\n42:  * Cross component steps definitions.\\n43:  *\\n44:  * Basic web application definitions from MinkExtension and\\n45:  * BehatchExtension. Definitions modified according to our needs\\n46:  * when necessary and including only the ones we need to avoid\\n47:  * overlapping and confusion.\\n48:  *\\n49:  * @package   core\\n50:  * @category  test\\n51:  * @copyright 2012 David Monllaó\\n52:  * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later\\n53:  */\\n54: class behat_general extends behat_base {\\n55:     /**\\n56:      * @var string used by {@link switch_to_window()} and\\n57:      * {@link switch_to_the_main_window()} to work-around a Chrome browser issue.\\n58:      */\\n59:     public const MAIN_WINDOW_NAME = '__moodle_behat_main_window_name';\\n60: \\n61:     /**\\n62:      * @var string when we want to check whether or not a new page has loaded,\\n63:      * we first write this unique string into the page. Then later, by checking\\n64:      * whether it is still there, we can tell if a new page has been loaded.\\n65:      */\\n66:     public const PAGE_LOAD_DETECTION_STRING = 'new_page_not_loaded_since_behat_started_watching';\\n67: \\n68:     /**\\n69:      * @var $pageloaddetectionrunning boolean Used to ensure that page load detection was started before a page reload\\n70:      * was checked for.\\n71:      */\\n72:     private bool $pageloaddetectionrunning = false;\\n73: \\n74:     /**\\n75:      * Opens Moodle homepage.\\n76:      *\\n77:      * @Given /^I am on homepage$/\\n78:      */\\n79:     public function i_am_on_homepage() {\\n80:         $this->execute([self::class, 'i_visit'], ['/']);\\n81:     }\\n82: \\n83:     /**\\n84:      * Opens Moodle site homepage.\\n85:      *\\n86:      * @Given /^I am on site homepage$/\\n87:      */\\n88:     public function i_am_on_site_homepage() {\\n89:         $this->execute([self::class, 'i_visit'], ['/?redirect=0']);\\n90:     }\\n91: \\n92:     /**\\n93:      * Opens course index page.\\n94:      *\\n95:      * @Given /^I am on course index$/\\n96:      */\\n97:     public function i_am_on_course_index() {\\n98:         $this->execute([self::class, 'i_visit'], ['/course/index.php']);\\n99:     }\\n100: \\n101:     /**\\n102:      * Checks, that current page PATH matches regular expression\\n103:      *\\n104:      * Example: Then the url should match \\\"/course/index\\\\.php\\\"\\n105:      * Example: Then the url should match \\\"/mod/forum/view\\\\.php\\\\?id=[0-9]+\\\"\\n106:      * Example: And the url should match \\\"^http://moodle\\\\.org\\\"\\n107:      *\\n108:      * @Then /^the url should match (?P<pattern>\\\"(?:[^\\\"]|\\\\\\\\\\\")*\\\")$/\\n109:      * @param string $pattern The pattern that must match to the current url.\\n110:      */\\n111:     public function the_url_should_match($pattern) {\\n112:         $url = $this->getSession()->getCurrentUrl();\\n113: \\n114:         if (preg_match($pattern, $url) === 1) {\\n115:             return;\\n116:         }\\n117: \\n118:         throw new ExpectationException(sprintf('The url \\\"%s\\\" should match with %s', $url, $pattern), $this->getSession());\\n119:     }\\n120: \\n121:     /**\\n122:      * Reloads the current page.\\n123:      *\\n124:      * @Given /^I reload the page$/\\n125:      */\\n126:     public function reload() {\\n127:         $this->getSession()->reload();\\n128:     }\\n129: \\n130:     /**\\n131:      * Follows the page redirection. Use this step after any action that shows a message and waits for a redirection\\n132:      *\\n133:      * @Given /^I wait to be redirected$/\\n134:      */\\n135:     public function i_wait_to_be_redirected() {\\n136: \\n137:         // Xpath and processes based on core_renderer::redirect_message(), core_renderer::$metarefreshtag and\\n138:         // moodle_page::$periodicrefreshdelay possible values.\\n139:         if (!$metarefresh = $this->getSession()->getPage()->find('xpath', \\\"//head/descendant::meta[@http-equiv='refresh']\\\")) {\\n140:             // We don't fail the scenario if no redirection with message is found to avoid race condition false failures.\\n141:             return true;\\n142:         }\\n143: \\n144:         // Wrapped in try & catch in case the redirection has already been executed.\\n145:         try {\\n146:             $content = $metarefresh->getAttribute('content');\\n147:         } catch (NoSuchElementException $e) {\\n148:             return true;\\n149:         } catch (StaleElementReferenceException $e) {\\n150:             return true;\\n151:         }\\n152: \\n153:         // Getting the refresh time and the url if present.\\n154:         if (strstr($content, 'url') != false) {\\n155:             [$waittime, $url] = explode(';', $content);\\n156: \\n157:             // Cleaning the URL value.\\n158:             $url = trim(substr($url, strpos($url, 'http')));\\n159:         } else {\\n160:             // Just wait then.\\n161:             $waittime = $content;\\n162:         }\\n163: \\n164:         // Wait until the URL change is executed.\\n165:         if ($this->running_javascript()) {\\n166:             $this->getSession()->wait($waittime * 1000);\\n167:         } else if (!empty($url)) {\\n168:             // We redirect directly as we can not wait for an automatic redirection.\\n169:             $this->getSession()->getDriver()->getClient()->request('GET', $url);\\n170:         } else {\\n171:             // Reload the page if no URL was provided.\\n172:             $this->getSession()->getDriver()->reload();\\n173:         }\\n174:     }\\n175: \\n176:     /**\\n177:      * Switches to the specified iframe.\\n178:      *\\n179:      * @Given /^I switch to \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" iframe$/\\n180:      * @Given /^I switch to \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" class iframe$/\\n181:      * @param string $name The name of the iframe\\n182:      */\\n183:     public function switch_to_iframe($name) {\\n184:         // We spin to give time to the iframe to be loaded.\\n185:         // Using extended timeout as we don't know about which\\n186:         // kind of iframe will be loaded.\\n187:         $this->spin(\\n188:             function ($context) use ($name) {\\n189:                 $iframe = $context->find('iframe', $name);\\n190:                 if ($iframe->hasAttribute('name')) {\\n191:                     $iframename = $iframe->getAttribute('name');\\n192:                 } else {\\n193:                     if (!$this->running_javascript()) {\\n194:                         throw new \\\\coding_exception('iframe must have a name attribute to use the switchTo command.');\\n195:                     }\\n196:                     $iframename = uniqid();\\n197:                     $this->execute_js_on_node($iframe, \\\"{{ELEMENT}}.name = '{$iframename}';\\\");\\n198:                 }\\n199:                 $context->getSession()->switchToIFrame($iframename);\\n200:                 // Wait until the iframe is completely loaded and all pending operations complete.\\n201:                 $context->getSession()->wait(behat_base::get_extended_timeout(), behat_base::PAGE_READY_JS);\\n202: \\n203:                 // If no exception we are done.\\n204:                 return true;\\n205:             },\\n206:             behat_base::get_extended_timeout()\\n207:         );\\n208:     }\\n209: \\n210:     /**\\n211:      * Wait until the specified iframe is interactable (visible, sized, and not occluded).\\n212:      *\\n213:      * @Given /^I wait until \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" iframe is interactable$/\\n214:      * @Given /^I wait until \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" class iframe is interactable$/\\n215:      * @param string $name The name or class of the iframe\\n216:      */\\n217:     public function wait_until_iframe_interactable(string $name): void {\\n218:         if (!$this->running_javascript()) {\\n219:             throw new DriverException(\\n220:                 'iFrame interactability checks are disabled in scenarios without Javascript support',\\n221:             );\\n222:         }\\n223:         $this->spin(\\n224:             function ($context) use ($name) {\\n225:                 $iframe = $context->find('iframe', $name);\\n226:                 $scrolljs = '{{ELEMENT}}.scrollIntoView({behavior: \\\"auto\\\", block: \\\"center\\\", inline: \\\"center\\\"});';\\n227:                 $this->execute_js_on_node($iframe, $scrolljs);\\n228:                 $this->ensure_node_is_visible($iframe);\\n229: \\n230:                 // Check that the iframe is not occluded at its center point.\\n231:                 $iframexpath = $iframe->getXpath();\\n232:                 $js = <<<EOF\\n233:                     (function() {\\n234:                         const xpath = \\\"{$iframexpath}\\\";\\n235:                         const el = document.evaluate(\\n236:                             xpath,\\n237:                             document,\\n238:                             null,\\n239:                             XPathResult.FIRST_ORDERED_NODE_TYPE,\\n240:                             null\\n241:                         ).singleNodeValue;\\n242:                         if (!el) { return false; }\\n243:                         const rect = el.getBoundingClientRect();\\n244:                         if (rect.width === 0 || rect.height === 0) { return false; }\\n245:                         const x = rect.left + rect.width / 2;\\n246:                         const y = rect.top + rect.height / 2;\\n247:                         const target = document.elementFromPoint(x, y);\\n248:                         return target === el || el.contains(target);\\n249:                     })()\\n250:                 EOF;\\n251: \\n252:                 return (bool) $this->evaluate_script($js);\\n253:             },\\n254:             behat_base::get_extended_timeout()\\n255:         );\\n256:     }\\n257: \\n258:     /**\\n259:      * Wait until the specified iframe is interactable (visible, sized, and not occluded) and switche to it.\\n260:      *\\n261:      * @Given /^I wait until \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" iframe is interactable and switch to it$/\\n262:      * @Given /^I wait until \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" class iframe is interactable and switch to it$/\\n263:      * @param string $name The name of the iframe\\n264:      */\\n265:     public function wait_until_iframe_interactable_and_switch_to(string $name): void {\\n266:         $this->wait_until_iframe_interactable($name);\\n267:         $this->switch_to_iframe($name);\\n268:     }\\n269: \\n270:     /**\\n271:      * Switches to the main Moodle frame.\\n272:      *\\n273:      * @Given /^I switch to the main frame$/\\n274:      */\\n275:     public function switch_to_the_main_frame() {\\n276:         $this->getSession()->switchToIFrame();\\n277:     }\\n278: \\n279:     /**\\n280:      * Switches to the specified window. Useful when interacting with popup windows.\\n281:      *\\n282:      * @Given /^I switch to \\\"(?P<window_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" (window|tab)$/\\n283:      * @param string $windowname\\n284:      */\\n285:     public function switch_to_window($windowname) {\\n286:         if ($windowname === self::MAIN_WINDOW_NAME) {\\n287:             // When switching to the main window normalise the window name to null.\\n288:             // This is normalised further in the Mink driver to the root window ID.\\n289:             $windowname = null;\\n290:         }\\n291: \\n292:         $this->getSession()->switchToWindow($windowname);\\n293:     }\\n294: \\n295:     /**\\n296:      * Switches to a second window.\\n297:      *\\n298:      * @Given /^I switch to a second window$/\\n299:      * @throws DriverException If there aren't exactly 2 windows open.\\n300:      */\"}"}],"details":{"serverName":"study","mcpToolName":"moodle_repair_read","rawContent":[{"type":"text","text":"{\"path\":\"public/lib/tests/behat/behat_general.php\",\"totalLines\":2899,\"text\":\"1: <?php\\n2: // This file is part of Moodle - http://moodle.org/\\n3: //\\n4: // Moodle is free software: you can redistribute it and/or modify\\n5: // it under the terms of the GNU General Public License as published by\\n6: // the Free Software Foundation, either version 3 of the License, or\\n7: // (at your option) any later version.\\n8: //\\n9: // Moodle is distributed in the hope that it will be useful,\\n10: // but WITHOUT ANY WARRANTY; without even the implied warranty of\\n11: // MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\\n12: // GNU General Public License for more details.\\n13: //\\n14: // You should have received a copy of the GNU General Public License\\n15: // along with Moodle.  If not, see <http://www.gnu.org/licenses/>.\\n16: \\n17: /**\\n18:  * General use steps definitions.\\n19:  *\\n20:  * @package   core\\n21:  * @category  test\\n22:  * @copyright 2012 David Monllaó\\n23:  * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later\\n24:  */\\n25: \\n26: // NOTE: no MOODLE_INTERNAL test here, this file may be required by behat before including /config.php.\\n27: \\n28: require_once(__DIR__ . '/../../behat/behat_base.php');\\n29: \\n30: use Behat\\\\Gherkin\\\\Node\\\\TableNode;\\n31: use Behat\\\\Mink\\\\Element\\\\NodeElement;\\n32: use Behat\\\\Mink\\\\Exception\\\\DriverException;\\n33: use Behat\\\\Mink\\\\Exception\\\\ElementNotFoundException;\\n34: use Behat\\\\Mink\\\\Exception\\\\ExpectationException;\\n35: use Facebook\\\\WebDriver\\\\Exception\\\\NoSuchAlertException;\\n36: use Facebook\\\\WebDriver\\\\Exception\\\\NoSuchElementException;\\n37: use Facebook\\\\WebDriver\\\\Exception\\\\StaleElementReferenceException;\\n38: use Facebook\\\\WebDriver\\\\WebDriverAlert;\\n39: use Facebook\\\\WebDriver\\\\WebDriverExpectedCondition;\\n40: \\n41: /**\\n42:  * Cross component steps definitions.\\n43:  *\\n44:  * Basic web application definitions from MinkExtension and\\n45:  * BehatchExtension. Definitions modified according to our needs\\n46:  * when necessary and including only the ones we need to avoid\\n47:  * overlapping and confusion.\\n48:  *\\n49:  * @package   core\\n50:  * @category  test\\n51:  * @copyright 2012 David Monllaó\\n52:  * @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later\\n53:  */\\n54: class behat_general extends behat_base {\\n55:     /**\\n56:      * @var string used by {@link switch_to_window()} and\\n57:      * {@link switch_to_the_main_window()} to work-around a Chrome browser issue.\\n58:      */\\n59:     public const MAIN_WINDOW_NAME = '__moodle_behat_main_window_name';\\n60: \\n61:     /**\\n62:      * @var string when we want to check whether or not a new page has loaded,\\n63:      * we first write this unique string into the page. Then later, by checking\\n64:      * whether it is still there, we can tell if a new page has been loaded.\\n65:      */\\n66:     public const PAGE_LOAD_DETECTION_STRING = 'new_page_not_loaded_since_behat_started_watching';\\n67: \\n68:     /**\\n69:      * @var $pageloaddetectionrunning boolean Used to ensure that page load detection was started before a page reload\\n70:      * was checked for.\\n71:      */\\n72:     private bool $pageloaddetectionrunning = false;\\n73: \\n74:     /**\\n75:      * Opens Moodle homepage.\\n76:      *\\n77:      * @Given /^I am on homepage$/\\n78:      */\\n79:     public function i_am_on_homepage() {\\n80:         $this->execute([self::class, 'i_visit'], ['/']);\\n81:     }\\n82: \\n83:     /**\\n84:      * Opens Moodle site homepage.\\n85:      *\\n86:      * @Given /^I am on site homepage$/\\n87:      */\\n88:     public function i_am_on_site_homepage() {\\n89:         $this->execute([self::class, 'i_visit'], ['/?redirect=0']);\\n90:     }\\n91: \\n92:     /**\\n93:      * Opens course index page.\\n94:      *\\n95:      * @Given /^I am on course index$/\\n96:      */\\n97:     public function i_am_on_course_index() {\\n98:         $this->execute([self::class, 'i_visit'], ['/course/index.php']);\\n99:     }\\n100: \\n101:     /**\\n102:      * Checks, that current page PATH matches regular expression\\n103:      *\\n104:      * Example: Then the url should match \\\"/course/index\\\\.php\\\"\\n105:      * Example: Then the url should match \\\"/mod/forum/view\\\\.php\\\\?id=[0-9]+\\\"\\n106:      * Example: And the url should match \\\"^http://moodle\\\\.org\\\"\\n107:      *\\n108:      * @Then /^the url should match (?P<pattern>\\\"(?:[^\\\"]|\\\\\\\\\\\")*\\\")$/\\n109:      * @param string $pattern The pattern that must match to the current url.\\n110:      */\\n111:     public function the_url_should_match($pattern) {\\n112:         $url = $this->getSession()->getCurrentUrl();\\n113: \\n114:         if (preg_match($pattern, $url) === 1) {\\n115:             return;\\n116:         }\\n117: \\n118:         throw new ExpectationException(sprintf('The url \\\"%s\\\" should match with %s', $url, $pattern), $this->getSession());\\n119:     }\\n120: \\n121:     /**\\n122:      * Reloads the current page.\\n123:      *\\n124:      * @Given /^I reload the page$/\\n125:      */\\n126:     public function reload() {\\n127:         $this->getSession()->reload();\\n128:     }\\n129: \\n130:     /**\\n131:      * Follows the page redirection. Use this step after any action that shows a message and waits for a redirection\\n132:      *\\n133:      * @Given /^I wait to be redirected$/\\n134:      */\\n135:     public function i_wait_to_be_redirected() {\\n136: \\n137:         // Xpath and processes based on core_renderer::redirect_message(), core_renderer::$metarefreshtag and\\n138:         // moodle_page::$periodicrefreshdelay possible values.\\n139:         if (!$metarefresh = $this->getSession()->getPage()->find('xpath', \\\"//head/descendant::meta[@http-equiv='refresh']\\\")) {\\n140:             // We don't fail the scenario if no redirection with message is found to avoid race condition false failures.\\n141:             return true;\\n142:         }\\n143: \\n144:         // Wrapped in try & catch in case the redirection has already been executed.\\n145:         try {\\n146:             $content = $metarefresh->getAttribute('content');\\n147:         } catch (NoSuchElementException $e) {\\n148:             return true;\\n149:         } catch (StaleElementReferenceException $e) {\\n150:             return true;\\n151:         }\\n152: \\n153:         // Getting the refresh time and the url if present.\\n154:         if (strstr($content, 'url') != false) {\\n155:             [$waittime, $url] = explode(';', $content);\\n156: \\n157:             // Cleaning the URL value.\\n158:             $url = trim(substr($url, strpos($url, 'http')));\\n159:         } else {\\n160:             // Just wait then.\\n161:             $waittime = $content;\\n162:         }\\n163: \\n164:         // Wait until the URL change is executed.\\n165:         if ($this->running_javascript()) {\\n166:             $this->getSession()->wait($waittime * 1000);\\n167:         } else if (!empty($url)) {\\n168:             // We redirect directly as we can not wait for an automatic redirection.\\n169:             $this->getSession()->getDriver()->getClient()->request('GET', $url);\\n170:         } else {\\n171:             // Reload the page if no URL was provided.\\n172:             $this->getSession()->getDriver()->reload();\\n173:         }\\n174:     }\\n175: \\n176:     /**\\n177:      * Switches to the specified iframe.\\n178:      *\\n179:      * @Given /^I switch to \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" iframe$/\\n180:      * @Given /^I switch to \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" class iframe$/\\n181:      * @param string $name The name of the iframe\\n182:      */\\n183:     public function switch_to_iframe($name) {\\n184:         // We spin to give time to the iframe to be loaded.\\n185:         // Using extended timeout as we don't know about which\\n186:         // kind of iframe will be loaded.\\n187:         $this->spin(\\n188:             function ($context) use ($name) {\\n189:                 $iframe = $context->find('iframe', $name);\\n190:                 if ($iframe->hasAttribute('name')) {\\n191:                     $iframename = $iframe->getAttribute('name');\\n192:                 } else {\\n193:                     if (!$this->running_javascript()) {\\n194:                         throw new \\\\coding_exception('iframe must have a name attribute to use the switchTo command.');\\n195:                     }\\n196:                     $iframename = uniqid();\\n197:                     $this->execute_js_on_node($iframe, \\\"{{ELEMENT}}.name = '{$iframename}';\\\");\\n198:                 }\\n199:                 $context->getSession()->switchToIFrame($iframename);\\n200:                 // Wait until the iframe is completely loaded and all pending operations complete.\\n201:                 $context->getSession()->wait(behat_base::get_extended_timeout(), behat_base::PAGE_READY_JS);\\n202: \\n203:                 // If no exception we are done.\\n204:                 return true;\\n205:             },\\n206:             behat_base::get_extended_timeout()\\n207:         );\\n208:     }\\n209: \\n210:     /**\\n211:      * Wait until the specified iframe is interactable (visible, sized, and not occluded).\\n212:      *\\n213:      * @Given /^I wait until \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" iframe is interactable$/\\n214:      * @Given /^I wait until \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" class iframe is interactable$/\\n215:      * @param string $name The name or class of the iframe\\n216:      */\\n217:     public function wait_until_iframe_interactable(string $name): void {\\n218:         if (!$this->running_javascript()) {\\n219:             throw new DriverException(\\n220:                 'iFrame interactability checks are disabled in scenarios without Javascript support',\\n221:             );\\n222:         }\\n223:         $this->spin(\\n224:             function ($context) use ($name) {\\n225:                 $iframe = $context->find('iframe', $name);\\n226:                 $scrolljs = '{{ELEMENT}}.scrollIntoView({behavior: \\\"auto\\\", block: \\\"center\\\", inline: \\\"center\\\"});';\\n227:                 $this->execute_js_on_node($iframe, $scrolljs);\\n228:                 $this->ensure_node_is_visible($iframe);\\n229: \\n230:                 // Check that the iframe is not occluded at its center point.\\n231:                 $iframexpath = $iframe->getXpath();\\n232:                 $js = <<<EOF\\n233:                     (function() {\\n234:                         const xpath = \\\"{$iframexpath}\\\";\\n235:                         const el = document.evaluate(\\n236:                             xpath,\\n237:                             document,\\n238:                             null,\\n239:                             XPathResult.FIRST_ORDERED_NODE_TYPE,\\n240:                             null\\n241:                         ).singleNodeValue;\\n242:                         if (!el) { return false; }\\n243:                         const rect = el.getBoundingClientRect();\\n244:                         if (rect.width === 0 || rect.height === 0) { return false; }\\n245:                         const x = rect.left + rect.width / 2;\\n246:                         const y = rect.top + rect.height / 2;\\n247:                         const target = document.elementFromPoint(x, y);\\n248:                         return target === el || el.contains(target);\\n249:                     })()\\n250:                 EOF;\\n251: \\n252:                 return (bool) $this->evaluate_script($js);\\n253:             },\\n254:             behat_base::get_extended_timeout()\\n255:         );\\n256:     }\\n257: \\n258:     /**\\n259:      * Wait until the specified iframe is interactable (visible, sized, and not occluded) and switche to it.\\n260:      *\\n261:      * @Given /^I wait until \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" iframe is interactable and switch to it$/\\n262:      * @Given /^I wait until \\\"(?P<iframe_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" class iframe is interactable and switch to it$/\\n263:      * @param string $name The name of the iframe\\n264:      */\\n265:     public function wait_until_iframe_interactable_and_switch_to(string $name): void {\\n266:         $this->wait_until_iframe_interactable($name);\\n267:         $this->switch_to_iframe($name);\\n268:     }\\n269: \\n270:     /**\\n271:      * Switches to the main Moodle frame.\\n272:      *\\n273:      * @Given /^I switch to the main frame$/\\n274:      */\\n275:     public function switch_to_the_main_frame() {\\n276:         $this->getSession()->switchToIFrame();\\n277:     }\\n278: \\n279:     /**\\n280:      * Switches to the specified window. Useful when interacting with popup windows.\\n281:      *\\n282:      * @Given /^I switch to \\\"(?P<window_name_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" (window|tab)$/\\n283:      * @param string $windowname\\n284:      */\\n285:     public function switch_to_window($windowname) {\\n286:         if ($windowname === self::MAIN_WINDOW_NAME) {\\n287:             // When switching to the main window normalise the window name to null.\\n288:             // This is normalised further in the Mink driver to the root window ID.\\n289:             $windowname = null;\\n290:         }\\n291: \\n292:         $this->getSession()->switchToWindow($windowname);\\n293:     }\\n294: \\n295:     /**\\n296:      * Switches to a second window.\\n297:      *\\n298:      * @Given /^I switch to a second window$/\\n299:      * @throws DriverException If there aren't exactly 2 windows open.\\n300:      */\"}"}],"provider":"mcp-json","providerName":"MCP Config"},"isError":false,"timestamp":1794801369325},{"role":"toolResult","toolCallId":"toolu_01T1xQ62Jo28qVu4ErDjfyru","toolName":"mcp__study_moodle_repair_read","content":[{"type":"text","text":"{\"path\":\"public/lib/tests/behat/behat_general.php\",\"totalLines\":2899,\"text\":\"300:      */\\n301:     public function switch_to_second_window() {\\n302:         $names = $this->getSession()->getWindowNames();\\n303: \\n304:         if (count($names) !== 2) {\\n305:             throw new DriverException('Expected to see 2 windows open, found ' . count($names));\\n306:         }\\n307: \\n308:         $this->getSession()->switchToWindow($names[1]);\\n309:     }\\n310: \\n311:     /**\\n312:      * Switches to the main Moodle window. Useful when you finish interacting with popup windows.\\n313:      *\\n314:      * @Given /^I switch to the main (window|tab)$/\\n315:      */\\n316:     public function switch_to_the_main_window() {\\n317:         $this->switch_to_window(self::MAIN_WINDOW_NAME);\\n318:     }\\n319: \\n320:     /**\\n321:      * Closes all extra windows opened during the navigation.\\n322:      *\\n323:      * This assumes all popups are opened by the main tab and you will now get back.\\n324:      *\\n325:      * @Given /^I close all opened windows$/\\n326:      * @throws DriverException If there aren't exactly 1 tabs open when finish or no javascript running\\n327:      */\\n328:     public function i_close_all_opened_windows() {\\n329:         if (!$this->running_javascript()) {\\n330:             throw new DriverException('Closing windows steps require javascript');\\n331:         }\\n332:         $names = $this->getSession()->getWindowNames();\\n333:         for ($index = 1; $index < count($names); $index++) {\\n334:             $this->getSession()->switchToWindow($names[$index]);\\n335:             $this->execute_script(\\\"window.open('', '_self').close();\\\");\\n336:         }\\n337:         $names = $this->getSession()->getWindowNames();\\n338:         if (count($names) !== 1) {\\n339:             throw new DriverException('Expected to see 1 tabs open, not ' . count($names));\\n340:         }\\n341:         $this->getSession()->switchToWindow($names[0]);\\n342:     }\\n343: \\n344:     /**\\n345:      * Wait for an alert to be displayed.\\n346:      *\\n347:      * @return WebDriverAlert\\n348:      */\\n349:     public function wait_for_alert(): WebDriverAlert {\\n350:         $webdriver = $this->getSession()->getDriver()->getWebdriver();\\n351:         $webdriver->wait()->until(WebDriverExpectedCondition::alertIsPresent());\\n352: \\n353:         return $webdriver->switchTo()->alert();\\n354:     }\\n355: \\n356:     /**\\n357:      * Accepts the currently displayed alert dialog. This step does not work in all the browsers, consider it experimental.\\n358:      * @Given /^I accept the currently displayed dialog$/\\n359:      */\\n360:     public function accept_currently_displayed_alert_dialog() {\\n361:         $alert = $this->wait_for_alert();\\n362:         $alert->accept();\\n363:     }\\n364: \\n365:     /**\\n366:      * Dismisses the currently displayed alert dialog. This step does not work in all the browsers, consider it experimental.\\n367:      * @Given /^I dismiss the currently displayed dialog$/\\n368:      */\\n369:     public function dismiss_currently_displayed_alert_dialog() {\\n370:         $alert = $this->wait_for_alert();\\n371:         $alert->dismiss();\\n372:     }\\n373: \\n374:     /**\\n375:      * Clicks link with specified id|title|alt|text.\\n376:      *\\n377:      * @When /^I follow \\\"(?P<link_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\"$/\\n378:      * @throws ElementNotFoundException Thrown by behat_base::find\\n379:      * @param string $link\\n380:      */\\n381:     public function click_link($link) {\\n382:         $linknode = $this->find_link($link);\\n383:         $linknode->click();\\n384:     }\\n385: \\n386:     /**\\n387:      * Waits X seconds. Required after an action that requires data from an AJAX request.\\n388:      *\\n389:      * @Then /^I wait \\\"(?P<seconds_number>\\\\d+)\\\" seconds$/\\n390:      * @param int $seconds\\n391:      */\\n392:     public function i_wait_seconds($seconds) {\\n393:         if ($this->running_javascript()) {\\n394:             $this->getSession()->wait($seconds * 1000);\\n395:         } else {\\n396:             sleep($seconds);\\n397:         }\\n398:     }\\n399: \\n400:     /**\\n401:      * Waits until the page is completely loaded. This step is auto-executed after every step.\\n402:      *\\n403:      * @Given /^I wait until the page is ready$/\\n404:      */\\n405:     public function wait_until_the_page_is_ready() {\\n406: \\n407:         // No need to wait if not running JS.\\n408:         if (!$this->running_javascript()) {\\n409:             return;\\n410:         }\\n411: \\n412:         $this->getSession()->wait(self::get_timeout() * 1000, self::PAGE_READY_JS);\\n413:     }\\n414: \\n415:     /**\\n416:      * Waits until the provided element selector exists in the DOM\\n417:      *\\n418:      * Using the protected method as this method will be usually\\n419:      * called by other methods which are not returning a set of\\n420:      * steps and performs the actions directly, so it would not\\n421:      * be executed if it returns another step.\\n422: \\n423:      * @Given /^I wait until \\\"(?P<element_string>(?:[^\\\"]|\\\\\\\\\\\")*)\\\" \\\"(?P<selector_string>[^\\\"]*)\\\" exi
#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Run every coded cell N times through run-item and require stable, expected results.

Current step definitions (sd-cur, sd-new): every healthy run passes and every bug run fails at
the frozen coded target step. Previous step definitions (sd-stale, sd-old): all N runs give the
same result. Runs go to scratch ledgers under --out and never touch bench/ledger.
"""
import argparse
from concurrent.futures import ThreadPoolExecutor
import json
from pathlib import Path
import shutil
import subprocess
import sys

BENCH = Path(__file__).resolve().parents[1]
CURRENT = {"sd-cur", "sd-new"}


def run(item_id, n, out):
    ledger = out / f"{item_id}.{n}"
    shutil.rmtree(ledger, ignore_errors=True)
    (ledger / "raw").mkdir(parents=True)
    proc = subprocess.run([BENCH / "runner/run-item", "--item", item_id, "--ledger-dir", ledger, "--workers", "1"],
                          capture_output=True, text=True)
    lines = (ledger / "attempts.jsonl").read_text().splitlines() if (ledger / "attempts.jsonl").exists() else []
    if not lines:
        return item_id, n, ("no-record", proc.stdout[-300:] + proc.stderr[-300:])
    record = json.loads(lines[-1])
    if not record["valid"]:
        return item_id, n, ("invalid", record.get("invalid_reason"))
    result = record["coded_result"]
    return item_id, n, (result["status"], result["failed_step"])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repeats", type=int, default=5)
    parser.add_argument("--workers", type=int, default=8)
    parser.add_argument("--out", type=Path, default=Path("/tmp/coded-stability"))
    parser.add_argument("--app", choices=["pay", "mdl"])
    args = parser.parse_args()
    plan = json.loads((BENCH / "plan/plan.json").read_text())
    targets = json.loads((BENCH / "plan/targets.json").read_text())
    cells = [item for item in plan["items"] if item["arm"].startswith("sd-") and item["rep"] == 1
             and (not args.app or item["app"] == args.app)]
    jobs = [(item["id"], n) for n in range(1, args.repeats + 1) for item in cells]
    results = {}
    with ThreadPoolExecutor(args.workers) as pool:
        for item_id, n, outcome in pool.map(lambda job: run(*job, args.out), jobs):
            results.setdefault(item_id, []).append(outcome)
            print(item_id, n, *outcome, flush=True)
    problems = []
    for item in cells:
        got = results[item["id"]]
        if any(o[0] in ("invalid", "no-record") for o in got):
            problems.append((item["id"], "invalid", got))
        elif item["arm"] in CURRENT:
            if item["condition"] == "healthy":
                expected = ("pass", None)
            else:
                step = targets[f"{item['app']}/{item['version']}/{item['scenario']}"]["coded"]["step"]
                expected = ("fail", step)
            if any(o != expected for o in got):
                problems.append((item["id"], f"expected {expected}", got))
        elif len(set(got)) != 1:
            problems.append((item["id"], "unstable", got))
    print(f"cells {len(cells)} runs {len(jobs)} problems {len(problems)}")
    for problem in problems:
        print("PROBLEM", *problem)
    sys.exit(1 if problems else 0)


if __name__ == "__main__":
    main()

#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
import argparse
import json
import math
import os
import random
import shutil
import signal
import subprocess
import sys
import time
from collections import defaultdict, deque
from concurrent.futures import FIRST_COMPLETED, ThreadPoolExecutor, wait
from datetime import datetime, timezone
from pathlib import Path
from tempfile import TemporaryDirectory

from ledger import ITEM_ID, Ledger, canonical, digest, locked
from notify import send

BENCH = Path(__file__).resolve().parents[1]
MAX_ATTEMPTS = 4
RUN_SECONDS = 300
GIB = 1024 ** 3
STOP_PROVIDER = "provider refusal"
STOP_GATE = "failed gate"
CONTROL_STOPS = {STOP_PROVIDER, STOP_GATE, "low memory", "low disk"}


def arguments():
    parser = argparse.ArgumentParser(description="Run locked plan items and append their attempts.")
    selection = parser.add_mutually_exclusive_group(required=True)
    selection.add_argument("--item", help="exact plan item ID")
    selection.add_argument("--filter", action="append", metavar="FIELD=VALUE",
                           help="exact item match; repeat to combine filters")
    parser.add_argument("--workers", type=int, default=1)
    parser.add_argument("--seed", type=int, default=0)
    parser.add_argument("--resume", action="store_true", help="skip items with a valid result in this ledger")
    parser.add_argument("--list-order", action="store_true", help="print seeded schedule and exit")
    parser.add_argument("--plan", type=Path, default=BENCH / "plan/plan.json")
    parser.add_argument("--ledger-dir", type=Path, default=BENCH / "ledger")
    parser.add_argument("--agent-run", type=Path, default=BENCH / "agent/run")
    parser.add_argument("--coded-run", type=Path, default=BENCH / "runner/coded-run")
    parser.add_argument("--lock-check", type=Path, default=BENCH / "tools/lock-check")
    parser.add_argument("--gate-check", type=Path, default=BENCH / "runner/check-gate")
    parser.add_argument("--env-lock", type=Path, default=BENCH / "env.lock.json")
    parser.add_argument("--smoke-times", type=Path,
                        help="JSON mapping arm IDs to smoke-test minutes")
    parser.add_argument("--alert-sink", type=Path, help="write alerts as JSONL for dry-run testing")
    parser.add_argument("--min-memory-bytes", type=int, default=GIB)
    parser.add_argument("--min-disk-bytes", type=int, default=2 * GIB)
    args = parser.parse_args()
    if args.workers < 1 or min(args.min_memory_bytes, args.min_disk_bytes) < 0:
        parser.error("workers must be positive and resource thresholds must be nonnegative")
    return args


def schedule(plan, args):
    filters = dict(pair.split("=", 1) for pair in args.filter or [])
    if len(filters) != len(args.filter or []):
        raise ValueError("duplicate filter field")
    items = plan["items"]
    known_fields = {key for item in items for key in item}
    if unknown := filters.keys() - known_fields:
        raise ValueError(f"unknown filter fields: {', '.join(sorted(unknown))}")
    selected = [item for item in items if (
        item["id"] == args.item if args.item else
        all(key in item and str(item[key]) == value for key, value in filters.items())
    )]
    if not selected:
        raise ValueError("no matching items")
    ids = [item["id"] for item in selected]
    if len(set(ids)) != len(ids) or any(not ITEM_ID.fullmatch(item) for item in ids):
        raise ValueError("selected items must have unique, safe IDs")

    repetitions = defaultdict(lambda: defaultdict(list))
    for item in sorted(selected, key=lambda item: item["id"]):
        repetitions[item["rep"]][item["app"], item["version"], item["scenario"],
                                 item.get("phase", "")].append(item)
    rng = random.Random(args.seed)
    ordered = []
    for _, blocks in sorted(repetitions.items()):
        keys = sorted(blocks)
        rng.shuffle(keys)
        for key in keys:
            rng.shuffle(blocks[key])
            ordered.extend(blocks[key])
    return ordered


def now():
    return datetime.now(timezone.utc).isoformat()


def run_command(executable, *arguments, timeout=RUN_SECONDS):
    env = {key: value for key, value in os.environ.items()
           if key not in {"TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID"}}
    try:
        with subprocess.Popen(
            [str(executable.resolve()), *map(str, arguments)], cwd=BENCH,
            env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True,
        ) as child:
            try:
                return child.wait(timeout=timeout)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(child.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                child.wait()
                return None
    except OSError:
        return None


def read_object(path):
    value = json.loads(path.read_bytes())
    if not isinstance(value, dict):
        raise ValueError(f"{path.name} must contain a JSON object")
    canonical(value)
    return value


def duration(value):
    return type(value) in {int, float} and math.isfinite(value) and value >= 0


def count(value):
    return type(value) is int and value >= 0


def adapter_result(raw, is_agent):
    value = read_object(raw / ("answer.json" if is_agent else "coded.json"))
    states = {"pass", "fail", "unresolved"} if is_agent else {"pass", "fail"}
    if value["status"] not in states or not duration(value["minutes"]):
        raise ValueError("invalid status or minutes")
    step = value["failed_step"]
    if step is not None and (type(step) is not int or step < 1):
        raise ValueError("invalid failing step")
    fields = ["status", "failed_step", "failed_step_text"]
    if value["failed_step_text"] is not None and not isinstance(value["failed_step_text"], str):
        raise ValueError("invalid failing step text")
    if is_agent:
        fields += ["reason", "raw"]
        causes = {"budget_time", "budget_tools", "loop", "no_readable_answer"}
        cause = value["unresolved_cause"]
        if (cause not in causes if value["status"] == "unresolved" else cause is not None):
            raise ValueError("invalid unresolved cause")
        if not count(value["tool_calls"]) or not all(
            count(value["tokens"][field]) for field in ("input", "cached", "output")
        ):
            raise ValueError("invalid token or tool count")
    else:
        fields += ["message"]
    return {field: value[field] for field in fields}, value


def attempt_run(args, item, arm, attempt, raw, worker, plan_identity, pins):
    started = now()
    clock = time.monotonic()
    is_agent = arm["kind"] == "agent"
    command = args.agent_run if is_agent else args.coded_run
    exit_code = run_command(command, "--item", raw / "item.json", "--out", raw)
    elapsed = (time.monotonic() - clock) / 60
    model_pin = pins.get("models", {}).get(item["arm"], {})
    tool_versions = {key: pins[key] for key in ("node", "playwright", "playwrightMcp", "codexCli")
                     if key in pins}
    record = {
        **plan_identity, "item_id": item["id"], "attempt": attempt, "worker": worker,
        "seed": args.seed, "arm": item["arm"], "started_at": started, "finished_at": now(),
        "image_digests": dict.fromkeys(("app", "db", "browser", "agent")),
        "tool_versions": tool_versions, "model": model_pin.get("id", arm.get("model")),
        "effort": model_pin.get("effort", arm.get("effort")),
        "prompt_sha256": pins.get("promptSha256") if is_agent else None,
        "scenario_sha256": None, "bug_id": item.get("bugId"),
        "valid": False, "invalid_reason": "invalid adapter output", "quarantined": True,
        "coded_result": None, "agent_answer": None, "unresolved_cause": None,
        "tokens": dict.fromkeys(("input", "cached", "output")), "minutes": elapsed,
        "tool_calls": None, "wall_minutes": elapsed, "adapter_exit": exit_code,
    }
    stop = None
    try:
        control_path = raw / "control.json"
        if control_path.exists():
            cause = read_object(control_path)["stop"]
            if not isinstance(cause, str) or cause not in CONTROL_STOPS:
                raise ValueError("invalid adapter stop")
            stop = cause
            record["invalid_reason"] = stop
            return record, stop
        provenance_path = raw / "provenance.json"
        if provenance_path.exists():
            provenance = read_object(provenance_path)
            for field in ("image_digests", "tool_versions"):
                if field in provenance:
                    record[field].update(provenance[field])
            for field in ("model", "effort", "prompt_sha256", "scenario_sha256"):
                if field in provenance:
                    record[field] = provenance[field]
        if exit_code is None:
            record["invalid_reason"] = "adapter unavailable or exceeded host timeout"
            return record, stop
        if not is_agent and exit_code not in {0, 1}:
            record["invalid_reason"] = "coded adapter infrastructure error"
            return record, stop
        answer, value = adapter_result(raw, is_agent)
        record["agent_answer" if is_agent else "coded_result"] = answer
        record["minutes"] = value["minutes"]
        if is_agent:
            record.update(unresolved_cause=value["unresolved_cause"],
                          tokens=value["tokens"], tool_calls=value["tool_calls"])
        record.update(valid=True, invalid_reason=None, quarantined=False)
    except (ValueError, KeyError, TypeError, OSError):
        pass
    return record, stop


class StopRules:
    def __init__(self, args):
        self.args = args
        self.invalid_workers = defaultdict(int)
        self.invalid_arms = defaultdict(int)
        self.slow = defaultdict(int)
        self.baselines = read_object(args.smoke_times) if args.smoke_times else {}
        if any(not duration(value) or value == 0 for value in self.baselines.values()):
            raise ValueError("smoke times must be positive minutes")

    def before_launch(self, raw_item):
        if shutil.disk_usage(self.args.ledger_dir).free < self.args.min_disk_bytes:
            return "low disk"
        available = next(int(line.split()[1]) * 1024
                         for line in Path("/proc/meminfo").read_text().splitlines()
                         if line.startswith("MemAvailable:"))
        if available < self.args.min_memory_bytes:
            return "low memory"
        if run_command(self.args.gate_check, "--item", raw_item, timeout=30) != 0:
            return STOP_GATE
        return None

    def after_attempt(self, record):
        worker, arm = record["worker"], record["arm"]
        for key, streaks in ((worker, self.invalid_workers), (arm, self.invalid_arms)):
            streaks[key] = 0 if record["valid"] else streaks[key] + 1
        baseline = self.baselines.get(arm)
        slow = baseline is not None and record["minutes"] > 2 * baseline
        self.slow[arm] = self.slow[arm] + 1 if slow else 0
        if self.invalid_workers[worker] >= 2 or self.invalid_arms[arm] >= 2:
            return "two consecutive invalid attempts"
        if self.slow[arm] >= 3:
            return "three consecutive slow runs"
        return None


def invalid_tail(records):
    count = 0
    for record in reversed(records):
        if record["valid"]:
            break
        count += 1
    return count


def announce_stop(args, reason, item):
    hints = {
        STOP_PROVIDER: "restore provider access or quota",
        STOP_GATE: "fix the lock, gate, or bug check and rerun",
        "low memory": "free memory or reduce the worker count",
        "low disk": "free ledger disk space",
        "two consecutive invalid attempts": "inspect the quarantined adapter artifacts",
        "three consecutive slow runs": "check worker load and provider response times",
    }
    message = f"P3 runner stopped at {item}: {reason}. Next: {hints[reason]}."
    print(message, file=sys.stderr)
    try:
        send(message, args.alert_sink)
    except (RuntimeError, OSError):
        print("Alert delivery failed.", file=sys.stderr)


def execute(args, plan, items, plan_bytes):
    args.ledger_dir.mkdir(parents=True, exist_ok=True)
    with locked(args.ledger_dir, exclusive=True):
        (args.ledger_dir / "attempts.jsonl").touch(exist_ok=True)
        ledger = Ledger(args.ledger_dir)
        # Resolve adapter paths independently of the caller's working directory.
        arms = {app: {arm["id"]: arm for arm in plan[app]["arms"]}
                for app in {item["app"] for item in items}}
        for item in items:
            if arms[item["app"]][item["arm"]]["kind"] not in {"agent", "coded"}:
                raise ValueError(f"unknown adapter kind for {item['id']}")
        rules = StopRules(args)
        identity = {"plan_id": plan["planId"], "plan_sha256": digest(plan_bytes)}
        if run_command(args.lock_check, timeout=30) != 0:
            announce_stop(args, STOP_GATE, items[0]["id"])
            return 2
        pins = read_object(args.env_lock) if args.env_lock.exists() else {}
        return work(args, ledger, rules, identity, arms, items, pins)


def work(args, ledger, rules, identity, arms, items, pins):
    queue = deque(items)
    free = list(range(args.workers, 0, -1))
    active = {}
    stopped = False
    missing = set()
    print(f"seed={args.seed} selected={len(items)} workers={args.workers}", flush=True)
    with TemporaryDirectory(prefix="p3-gate-") as preflight, ThreadPoolExecutor(args.workers) as pool:
        gate_item = Path(preflight) / "item.json"
        while active or (queue and not stopped):
            while queue and free and not stopped and not any(f.done() for f in active):
                item = queue.popleft()
                item_id = item["id"]
                history = ledger.history[item_id]
                if history and any(record["plan_sha256"] != identity["plan_sha256"] for record in history):
                    raise ValueError(f"plan changed for previously attempted item {item_id}")
                if args.resume and history and history[-1]["valid"]:
                    continue
                if invalid_tail(history) >= MAX_ATTEMPTS:
                    missing.add(item_id)
                    continue
                payload = canonical(item) + b"\n"
                gate_item.write_bytes(payload)
                if reason := rules.before_launch(gate_item):
                    announce_stop(args, reason, item_id)
                    stopped = True
                    break
                if any(f.done() for f in active):
                    queue.appendleft(item)
                    break
                attempt, raw = ledger.allocate(item_id)
                (raw / "item.json").write_bytes(payload)
                worker = free.pop()
                future = pool.submit(attempt_run, args, item, arms[item["app"]][item["arm"]],
                                     attempt, raw, worker, identity, pins)
                active[future] = item, raw
                print(f"launch {item_id} attempt={attempt} worker={worker}", flush=True)
            if not active:
                continue
            done, _ = wait(active, return_when=FIRST_COMPLETED)
            for future in sorted(done, key=lambda f: f.result()[0]["finished_at"]):
                item, raw = active.pop(future)
                record, adapter_stop = future.result()
                ledger.append(record, raw)
                free.append(record["worker"])
                reason = rules.after_attempt(record)
                if not record["valid"]:
                    if invalid_tail(ledger.history[item["id"]]) >= MAX_ATTEMPTS:
                        missing.add(item["id"])
                    else:
                        queue.appendleft(item)
                if not stopped and (reason := adapter_stop or reason):
                    announce_stop(args, reason, item["id"])
                    stopped = True
    for item_id in sorted(missing):
        print(f"missing {item_id}: four invalid attempts")
    if stopped:
        print(f"paused with {len(queue)} selected items pending")
        return 2
    return 3 if missing else 0


def main():
    args = arguments()
    try:
        plan_bytes = args.plan.read_bytes()
        plan = json.loads(plan_bytes)
        items = schedule(plan, args)
        if args.list_order:
            print(f"seed={args.seed}")
            print(*(item["id"] for item in items), sep="\n")
            return 0
        return execute(args, plan, items, plan_bytes)
    except (ValueError, KeyError, TypeError, OSError) as error:
        print(f"run-item: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())

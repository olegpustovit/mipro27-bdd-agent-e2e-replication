#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""Scan bench ledger, raw outputs and logs for credential signatures."""
import argparse
from pathlib import Path
import re
import sys


PATTERNS = {
    "Telegram bot token": re.compile(rb"(?<![0-9])[0-9]{6,}:[A-Za-z0-9_-]{30,}"),
    "OpenAI API key": re.compile(rb"sk-[A-Za-z0-9_-]{20,}"),
    "JWT": re.compile(rb"eyJ[A-Za-z0-9_-]+\.eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+"),
    "Credential field": re.compile(
        rb"""(?:access_token|refresh_token|id_token|TELEGRAM_BOT_TOKEN|OPENAI_API_KEY)["']?\s*[:=]\s*(?:\\?["'])?[A-Za-z0-9_./+=:-]{12,}""",
        re.IGNORECASE,
    ),
}
BENCH = Path(__file__).resolve().parents[1]


def redact(path):
    name = bytes(str(path), "utf-8", errors="backslashreplace")
    for pattern in PATTERNS.values():
        name = pattern.sub(b"[redacted]", name)
    return repr(name.decode("utf-8", errors="replace"))


def scan_file(path):
    if path.name == "auth.json":
        print(f"{redact(path)}: auth.json file")
        return False
    clean = True
    with path.open("rb") as source:
        for number, line in enumerate(source, 1):
            for label, pattern in PATTERNS.items():
                if pattern.search(line):
                    print(f"{redact(path)}:{number}: {label}")
                    clean = False
    return clean


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("paths", nargs="*", type=Path, help="files or output directories")
    arguments = parser.parse_args()
    default_paths = [BENCH / name for name in ("ledger", "raw", "logs")]
    paths = arguments.paths or [path for path in default_paths if path.exists()]
    clean = True
    errors = False
    for path in paths:
        try:
            if path.is_dir():
                files = (entry for entry in path.rglob("*") if entry.is_file())
            elif path.is_file():
                files = (path,)
            else:
                raise FileNotFoundError
            for file in files:
                clean = scan_file(file) and clean
        except OSError:
            print(f"{redact(path)}: scan failed", file=sys.stderr)
            errors = True
    if errors:
        return 2
    if clean:
        print("No credential signatures found")
    return int(not clean)


if __name__ == "__main__":
    sys.exit(main())

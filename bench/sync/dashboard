#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Sync finished ledger attempts, or run a batch with periodic and final sync."""
import argparse
from collections import defaultdict
import fcntl
import json
from pathlib import Path
import subprocess
import sys
import time

BENCH = Path(__file__).resolve().parents[1]
sys.path[:0] = [str(BENCH / name) for name in ("scoring", "runner")]
from ledger import ITEM_ID, ZERO, canonical, digest
from score import AGENTS, classify, target_key, total_cost
from report import load_targets

OUTCOMES = {"correct": "pass", "caught": "caught_target", "detected_elsewhere": "caught_other"}
ARMS = {"sd-cur", "sd-stale", "sd-old", "sd-new", "luna", "terra", "sol"}


def snapshot(path, *, final):
    # The runner holds its ledger lock for the entire batch. Read an append-only
    # prefix so active raw directories and a concurrent append cannot block sync.
    with path.open("rb") as source:
        size = source.seek(0, 2)
        source.seek(0)
        data = source.read(size)
    lines = data.split(b"\n")
    if final and lines[-1]:
        raise ValueError("ledger ends in an incomplete record")
    previous = ZERO
    attempts = defaultdict(list)
    for line in lines[:-1]:
        row = json.loads(line)
        record_hash = row.pop("record_sha256")
        if row["prev_record_sha256"] != previous or digest(canonical(row)) != record_hash:
            raise ValueError("ledger hash chain mismatch")
        item = row["item_id"]
        if row["attempt"] != len(attempts[item]) + 1:
            raise ValueError(f"unexpected attempt number for {item}")
        row["record_sha256"] = previous = record_hash
        attempts[item].append(row)
    return attempts


def project(plan, plan_hash, history, targets):
    items = {item["id"]: item for item in plan["items"]}
    for item_id, records in sorted(history.items()):
        item = items[item_id]
        app, arm, condition = (item[key] for key in ("app", "arm", "condition"))
        if app not in {"pay", "mdl"} or arm not in ARMS or not ITEM_ID.fullmatch(item_id):
            raise ValueError(f"invalid dashboard path for {item_id}")
        target = targets.get(target_key(item)) if condition == "bug" else None
        if target and "coded" in target:  # frozen targets.json: one target per approach
            target = target["agent" if arm in AGENTS else "coded"]
        if target and (type(target["step"]) is not int or target["step"] < 1):
            raise ValueError(f"invalid confirmed target for {item_id}")
        attempts = []
        for row in records:
            if (row["plan_id"], row["plan_sha256"], row["bug_id"], row["arm"]) != (
                plan["planId"], plan_hash, item.get("bugId"), arm
            ):
                raise ValueError(f"ledger provenance disagrees with plan for {item_id}")
            answer = row["agent_answer"] or row["coded_result"]
            if row["valid"] and condition == "bug" and not target and answer["status"] == "fail":
                outcome, step = "unresolved", answer["failed_step"]
            else:
                outcome, step = classify(row, condition, target)
            outcome = OUTCOMES.get(outcome, outcome)
            attempts.append({"n": row["attempt"], "started": row["started_at"],
                             "finished": row["finished_at"], "outcome": outcome,
                             "ledger_hash": row["record_sha256"]})
        yield f"res-{app}-{arm}", item_id, {
            "status": "done", "outcome": outcome, "failing_step": step,
            "tokens": total_cost([row])["tokens"],
            "minutes": row["minutes"], "attempts": attempts,
        }


def art(args, operation, *operands):
    result = subprocess.run(["art", "db", operation, args.artifact, *operands],
                            check=True, capture_output=True, text=True, timeout=30)
    return json.loads(result.stdout)


def sync(args, *, final=True):
    plan_bytes = args.plan.read_bytes()
    targets = json.loads(args.metadata.read_bytes()).get("targets", {}) if args.metadata else load_targets()[0]
    ledger = args.ledger_dir / "attempts.jsonl"
    if not final and not ledger.exists():
        return
    # Serialize publications for this ledger without taking the runner's lock.
    with ledger.open("rb") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        documents = list(project(json.loads(plan_bytes), digest(plan_bytes),
                                 snapshot(ledger, final=final), targets))
        existing = {}
        written = 0
        for collection, item, body in documents:
            if collection not in existing:
                existing[collection] = {}
                after = []
                while True:
                    page = art(args, "list", collection, "--limit", "100", *after)
                    existing[collection].update((doc["path"], doc["body"]) for doc in page["docs"])
                    if not page["next"]:
                        break
                    after = ["--after", page["next"]]
            path = f"{collection}/{item}"
            if existing[collection].get(path) != body:
                art(args, "set", path, canonical(body).decode())
                written += 1
        print(f"dashboard: {len(documents)} items, {written} writes", flush=True)


def batch(args):
    if any(arg.split("=", 1)[0] in {"--plan", "--ledger-dir"} for arg in args.batch):
        raise ValueError("put --plan and --ledger-dir before --batch")
    command = [str(BENCH / "runner/run-item"), "--plan", str(args.plan),
               "--ledger-dir", str(args.ledger_dir), *args.batch]
    if "--list-order" in args.batch:
        return subprocess.call(command)
    with subprocess.Popen(command) as runner:
        deadline = time.monotonic() + 900
        try:
            while True:
                try:
                    status = runner.wait(timeout=max(0, deadline - time.monotonic()))
                    break
                except subprocess.TimeoutExpired:
                    deadline = time.monotonic() + 900
                    try:
                        sync(args, final=False)
                    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
                        print(f"periodic dashboard sync failed: {error}", file=sys.stderr)
        except KeyboardInterrupt:
            runner.wait()
            raise
        finally:
            if (args.ledger_dir / "attempts.jsonl").exists():
                sync(args)
    return status


def main():
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument("--artifact", required=True)
    parser.add_argument("--plan", type=Path, default=BENCH / "plan/plan.json")
    parser.add_argument("--ledger-dir", type=Path, default=BENCH / "ledger")
    parser.add_argument("--metadata", type=Path, help="P3b scoring metadata with confirmed targets")
    parser.add_argument("--batch", nargs=argparse.REMAINDER, help="arguments for runner/run-item")
    args = parser.parse_args()
    try:
        if args.batch is not None:
            return batch(args)
        sync(args)
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        parser.exit(1, f"dashboard sync failed: {error}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Run the P3 runner with fixture adapters and sync into a disposable dashboard."""
import json
import os
from pathlib import Path
import re
import runpy
import subprocess
from tempfile import TemporaryDirectory
from types import SimpleNamespace
from unittest.mock import MagicMock, Mock, patch

BENCH = Path(__file__).resolve().parents[1]
LIVE = "kq608ae9cng6"
HEALTHY = "pay.v0.auth-login.healthy.sd-cur.r1"
BUG = "pay.v0.auth-login.bug.sd-cur.r1"


def run(*args, env=None, expected=0):
    result = subprocess.run(args, capture_output=True, text=True, env=env, timeout=120)
    assert result.returncode == expected, (result.returncode, result.stdout, result.stderr)
    return result.stdout


def check_schedule(ledger_dir):
    batch = runpy.run_path(str(BENCH / "sync/dashboard"))["batch"]
    runner = Mock()
    runner.wait.side_effect = [subprocess.TimeoutExpired("runner", 900), 2]
    launcher = MagicMock()
    launcher.return_value.__enter__.return_value = runner
    sync = Mock()
    clock = Mock(side_effect=[0, 0, 900, 900])
    args = SimpleNamespace(batch=["--item", HEALTHY], plan=BENCH / "plan/plan.json",
                           ledger_dir=ledger_dir)
    with patch.dict(batch.__globals__, {"sync": sync, "time": SimpleNamespace(monotonic=clock)}):
        with patch.object(subprocess, "Popen", launcher):
            assert batch(args) == 2
    assert [entry.kwargs for entry in runner.wait.call_args_list] == [{"timeout": 900}] * 2
    assert [entry.kwargs for entry in sync.call_args_list] == [{"final": False}, {}]
    print("PASS batch schedule: 900-second wait, periodic sync, final sync on stop")


with TemporaryDirectory(prefix="p3d-fixture-") as tmp:
    root = Path(tmp)
    page = root / "index.html"
    html = run("art", "read", LIVE, "index.html")
    page.write_text(html.replace("<title>", "<title>Disposable P3d fixture · ", 1))
    published = run("art", "publish", page, "--visibility", "private", "--icon", "chart",
                    "--capabilities", '{"db":{}}')
    artifact = re.search(r"/a/([a-z0-9]+)", published)[1]
    assert artifact != LIVE
    try:
        stub = root / "adapter"
        fixture = runpy.run_path(str(BENCH / "runner/test-p3"))["STUB"]
        fixture = fixture.replace('if item["arm"].startswith("sd-"):',
                                  'if item["condition"] == "bug":\n'
                                  '    answer.update(status="fail", failed_step=2)\n'
                                  'if item["arm"].startswith("sd-"):')
        stub.write_text(fixture)
        stub.chmod(0o755)
        targets = root / "targets.json"
        targets.write_text('{"targets":{"pay/v0/auth-login":{"step":2}}}')
        sync = [BENCH / "sync/dashboard", "--artifact", artifact, "--ledger-dir", root / "ledger",
                "--metadata", targets]
        batch = [*sync, "--batch", "--coded-run", stub, "--lock-check", "/usr/bin/true",
                 "--gate-check", "/usr/bin/true", "--min-disk-bytes", "0", "--min-memory-bytes", "0",
                 "--alert-sink", root / "alerts", "--item"]
        output = run(*batch, HEALTHY, expected=2, env=dict(os.environ, P3_TEST_MODE="invalid"))
        assert "dashboard: 1 items, 1 writes" in output, output
        invalid = json.loads(run("art", "db", "get", artifact, f"res-pay-sd-cur/{HEALTHY}"))
        assert [a["outcome"] for a in invalid["body"]["attempts"]] == ["invalid"] * 2
        for item in (HEALTHY, BUG):
            output = run(*batch, item, env=dict(os.environ, P3_TEST_MODE=""))
            assert "1 writes" in output, output

        def documents():
            return {item: json.loads(run("art", "db", "get", artifact, f"res-pay-sd-cur/{item}"))
                    for item in (HEALTHY, BUG)}

        before = documents()
        payload = {item: doc["body"] for item, doc in before.items()}
        assert [a["outcome"] for a in payload[HEALTHY]["attempts"]] == ["invalid"] * 2 + ["pass"]
        assert payload[BUG]["outcome"] == "caught_target"
        records = [json.loads(line) for line in (root / "ledger/attempts.jsonl").read_text().splitlines()]
        for item, body in payload.items():
            assert [a["ledger_hash"] for a in body["attempts"]] == [
                row["record_sha256"] for row in records if row["item_id"] == item
            ]

        # Exercise the production renderer with the actual bodies read back from the test DB.
        script = html.split("<script>")[-1].split('document.addEventListener("keydown"')[0]
        check = root / "render.cjs"
        check.write_text("""
const assert = require("node:assert/strict");
const detail = {};
const document = {getElementById: id => id === "detBody" ? detail : {appendChild(){}, classList:{add(){}, remove(){}}},
                  createElement: () => ({dataset:{}})};
""" + script + """
Object.assign(RES, JSON.parse(process.argv[2]));
const [healthy, bug] = Object.keys(RES);
assert.equal(cellClass(healthy), "o-pass");
assert.equal(cellClass(bug), "o-caught_target");
assert.match(require("node:fs").readFileSync(process.argv[3], "utf8"),
             /\\.o-pass,\\.o-caught_target\\{background:var\\(--ok\\)/);
openDet(healthy);
assert.deepEqual([...detail.innerHTML.matchAll(/#([1-9]) /g)].map(m => Number(m[1])), [1,2,3]);
openDet(bug);
assert.match(detail.innerHTML, /Caught at the targeted check/);
console.log("PASS fixture smoke: green pass and caught_target; detail lists attempts #1–#3");
""")
        print(run("node", check, json.dumps(payload), page).strip())
        for _ in range(2):
            print(run(*sync).strip())
        assert documents() == before
        print("PASS idempotence: document bodies, versions and update times unchanged")
        check_schedule(root / "ledger")
    finally:
        run("art", "delete", artifact, "--yes")
        print(f"Deleted disposable artifact {artifact}")

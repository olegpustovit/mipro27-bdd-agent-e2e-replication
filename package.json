{
  "name": "cucumber-mcp-study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "test:moodle": "node --test adapters/moodle/*.test.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "app": "node scripts/app.mjs",
    "reset": "node scripts/reset.mjs",
    "technical-check": "node scripts/technical-check.mjs",
    "calibrate": "node scripts/technical-check.mjs --all --variants",
    "check:attempts": "node scripts/attempt-observer.integration.mjs",
    "check:phases": "node scripts/phase-observer.integration.mjs",
    "check:session": "node scripts/runner.mjs --session-check",
    "check:timeout": "node scripts/timeout-session.integration.mjs",
    "plan": "node scripts/runner.mjs --plan",
    "pilot": "node scripts/runner.mjs --pilot",
    "campaign": "node scripts/runner.mjs --campaign",
    "analyze": "node scripts/analyze-campaigns.mjs --verify",
    "verify:pins": "node scripts/verify-source-pins.mjs",
    "console": "node scripts/console.mjs",
    "study": "node scripts/study.mjs",
    "analyze:moodle": "node scripts/analysis/moodle.mjs",
    "moodle:v1-report": "node scripts/moodle/v1-report.mjs",
    "moodle:timeline": "node scripts/moodle/timeline.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@playwright/mcp": "0.0.84",
    "acorn": "8.15.0",
    "playwright": "1.65.0-alpha-2026-10-30",
    "typescript": "5.8.3",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "study": "scripts/study.mjs"
  }
}
